---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/seo';
import '../styles/fonts.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/style.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  headerVariant?: 'default' | 'paper';
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  noindex = false,
  jsonLd,
  headerVariant = 'default',
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(image, site);
const ogImageWidth = image === SITE.defaultOgImage ? 1200 : undefined;
const ogImageHeight = image === SITE.defaultOgImage ? 630 : undefined;
const robots = noindex ? 'noindex, nofollow' : 'index,follow,max-image-preview:large';
const jsonLdString = jsonLd ? JSON.stringify(jsonLd) : null;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.legalName} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#22323a" />
  <meta name="geo.region" content="DE-ST" />
  <meta name="geo.placename" content="Magdeburg" />

  <link rel="canonical" href={canonicalURL} />
  <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={`${SITE.name} – Webdesign Magdeburg`} />
  {ogImageWidth && ogImageHeight && (
    <>
      <meta property="og:image:width" content={String(ogImageWidth)} />
      <meta property="og:image:height" content={String(ogImageHeight)} />
    </>
  )}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  {jsonLdString && (
    <script type="application/ld+json" set:html={jsonLdString} />
  )}
</head>
<body>
  <script is:inline>document.documentElement.classList.add('js-enabled');</script>
  <a href="#main-content" class="skip-link">Zum Inhalt springen</a>

  <Header variant={headerVariant} />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <script defer src="/site-effects.js"></script>
  <script is:inline>
    // === AutoShow: Original Logik ===
    (function () {
      const els = document.querySelectorAll('.autoShow');
      const reduced =
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window) || els.length === 0) {
        els.forEach(el => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        });
      }, { root: null, rootMargin: '0px 0px 12% 0px', threshold: 0.15 });
      els.forEach(el => io.observe(el));
    })();
  </script>

  <style is:global>

  :root {
    /* ── Palette ──
       1 Hintergrund · 2 Akzent-Hintergründe · 2 Highlights */
    --c-bg: #f4f4f9;          /* Hintergrund: Ghost White */
    --c-deep: #22323a;        /* Akzent-Hintergrund 1: Deep Slate (dunkles Blue Slate) */
    --c-sky: #b8dbd9;         /* Akzent-Hintergrund 2: Light Blue */
    --c-turf: #04724d;        /* Highlight 1: Turf Green */
    --c-slate: #586f7c;       /* Highlight 2: Blue Slate */
    /* zusätzliche Akzente – Varianten bestehender Farben */
    --c-forest: #0b3d2e;      /* Deep Forest: dunkles Turf Green */
    --c-mist: #dfeeed;        /* Mist: helles Light Blue */
    --c-cream: #f1e3c2;       /* Cream: Papier-Highlight (Karten & Buttons) */
    --c-sketch-paper: var(--c-bg); /* Skizzenpapier im Bleistift-Hero (und Header dazu) – gleich wie der Seitenhintergrund */
    /* Papier-Stil: zerknitterte Struktur (SVG-Lichtfilter) und federnde Drehung */
    /* Papierstruktur als fertig gerendertes Bild (vorher SVG-Filter feTurbulence + feDiffuseLighting,
       den der Browser bei jedem Zeichnen neu berechnen musste – ruckelte mobil) */
    --paper-texture: url('/textures/paper-texture.webp');
    --paper-spring: linear(0, 0.417 25.5%, 0.867 49.4%, 1 57.7%, 0.925 65.1%, 0.908 68.6%, 0.902 72.2%, 0.916 78.2%, 0.988 92.1%, 1);
    /* abgeleitete Farben */
    --c-ink: #1b262c;
    --c-muted: var(--c-slate);
    --c-line: rgba(88, 111, 124, 0.28);
    --c-surface: #ffffff;
    --c-turf-hover: #035c3e;
    --c-on-sky: #2b3a42;      /* Fließtext auf Light Blue (Kontrast 8:1) */
    /* Aliase für bestehende Stile */
    --c-black: var(--c-deep);
    --c-dark: var(--c-deep);
    --c-mint: var(--c-sky);
    --c-green: var(--c-turf);
    --c-green-ink: var(--c-turf);
    --c-gold: var(--c-sky);

    --bg-dark: #030712;
    --bg-surface: #0b1120;
    --r3-green: #10b981;
    --r3-green-bright: #34d399;
    --r3-green-deep: #059669;
    --r3-green-ink: #047857;
    --text-muted: #94a3b8;
    --site-header-height: 4.25rem;
  }

  /* Seitliches Überlaufen abschneiden, ohne <html> zum Scroll-Container zu machen:
     overflow-x: hidden auf <html> lässt in Chrome/Samsung Internet auf Android
     den fest stehenden Header beim Ein-/Ausblenden der Adressleiste springen oder kurz verschwinden */
  html {
    overflow-x: hidden;
  }

  @supports (overflow: clip) {
    html {
      overflow-x: clip;
    }
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  html, body {
    background-color: var(--c-bg);
    color: var(--c-ink);
    margin: 0;
    padding: 0;
    min-height: 100%;
  }

  body {
    background: var(--c-bg);
  }

  main {
    padding-top: var(--site-header-height);
  }

  #intro,
  #about,
  #leistungen,
  #projekte,
  #faq {
    scroll-margin-top: var(--site-header-height);
  }

  </style>

</body>
</html>
