---
import { SHOWCASE_COPY, STYLE_PRESETS } from '../data/style-showcase';
import { responsiveImage } from '../lib/images';
import DemoCowork from './showcase/DemoCowork.astro';
import DemoCafe from './showcase/DemoCafe.astro';
import DemoRun from './showcase/DemoRun.astro';
import DemoPraxis from './showcase/DemoPraxis.astro';
import '../styles/style-showcase.css';
import '../styles/style-demos.css';

const defaultStyle = STYLE_PRESETS[0];
// Geräte-Fotos (freigestellt); die Beispielseite wird exakt auf das Display gelegt
const laptop = responsiveImage('/images/laptop-mockup.webp', 1440);
const phone = responsiveImage('/images/phone-mockup.webp', 440);
---

<section class="style-lab" aria-labelledby="style-lab-title" data-style-showcase>
  <div class="container style-lab__inner">
    <div class="style-lab__intro autoShow">
      <h2 class="style-lab__title" id="style-lab-title">{SHOWCASE_COPY.title}</h2>
      <p class="style-lab__text">{SHOWCASE_COPY.text}</p>
      <div class="style-lab__tabs" role="group" aria-label="Stil wählen">
        {STYLE_PRESETS.map((preset) => (
          <button
            type="button"
            class="style-lab__tab"
            data-style-option={preset.id}
            aria-pressed={preset.id === defaultStyle.id ? 'true' : 'false'}
          >
            {preset.label}
          </button>
        ))}
      </div>
      <p class="style-lab__status" data-style-status aria-live="polite">
        {defaultStyle.label}: {defaultStyle.description}
      </p>
    </div>

    <div class="style-lab__stage autoShow" data-active-style={defaultStyle.id} data-style-stage data-nosnippet>
      <!-- Beispielseite: Desktop im Laptop, mobil im Smartphone (rein dekorativ) -->
      <div class="device-mock device-mock--laptop" aria-hidden="true" data-mock data-mock-width="1440">
        <div class="device-mock__stage">
          <img
            class="device-mock__img"
            src={laptop.src}
            srcset={laptop.srcset}
            sizes="720px"
            width={laptop.width}
            height={laptop.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="device-mock__screen">
            <div class="laptop__browser">
              <span class="laptop__dots"><i></i><i></i><i></i></span>
              <span class="laptop__url" data-style-url>{defaultStyle.url}</span>
            </div>
            <div class="demo-host">
              <DemoCowork />
              <DemoCafe sizes="330px" />
              <DemoRun />
              <DemoPraxis />
            </div>
          </div>
        </div>
      </div>

      <div class="device-mock device-mock--phone" aria-hidden="true" data-mock data-mock-width="440">
        <div class="device-mock__stage">
          <img
            class="device-mock__img"
            src={phone.src}
            width={phone.width}
            height={phone.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="device-mock__screen">
            <div class="phone__status">
              <span>10:09</span>
              <span class="phone__camera"></span>
              <span class="phone__icons"><i></i><i></i><i></i></span>
            </div>
            <div class="demo-host">
              <DemoCowork />
              <DemoCafe sizes="220px" />
              <DemoRun />
              <DemoPraxis />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ presets: STYLE_PRESETS }}>
  const root = document.querySelector('[data-style-showcase]');
  const stage = root?.querySelector('[data-style-stage]');
  const status = root?.querySelector('[data-style-status]');
  const url = root?.querySelector('[data-style-url]');
  const options = root ? [...root.querySelectorAll('[data-style-option]')] : [];

  // Geräte-Bühnen auf die Containerbreite skalieren (Bildkoordinaten je Foto)
  if ('ResizeObserver' in window) {
    root?.querySelectorAll('[data-mock]').forEach((box) => {
      const base = Number(box.dataset.mockWidth);
      new ResizeObserver(([entry]) => {
        if (entry.contentRect.width) box.style.setProperty('--k', String(entry.contentRect.width / base));
      }).observe(box);
    });
  }

  options.forEach((option) => {
    option.addEventListener('click', () => {
      const preset = presets.find((item) => item.id === option.dataset.styleOption);
      if (!preset || !stage) return;
      stage.setAttribute('data-active-style', preset.id);
      options.forEach((other) => other.setAttribute('aria-pressed', String(other === option)));
      if (status) status.textContent = `${preset.label}: ${preset.description}`;
      if (url) url.textContent = preset.url;
    });
  });
</script>
