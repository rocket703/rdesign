---
// Desktop-Screenshot im Rahmen, optional mit überlappendem Smartphone.
// Hover-Effekte greifen, wenn die Komponente in einem Link steckt.
import { responsiveImage } from '../lib/images';

interface Props {
  desktop: string;
  mobile?: string;
  title: string;
  /** sizes-Attribut für die Desktop-Ansicht */
  sizes?: string;
  priority?: boolean;
}

const {
  desktop,
  mobile,
  title,
  sizes = '(max-width: 900px) calc(100vw - 2rem), 1080px',
  priority = false,
} = Astro.props;

const desktopMedia = responsiveImage(desktop, 1600);
const mobileMedia = mobile ? responsiveImage(mobile, 800) : null;
---

<div class:list={['device-showcase', mobileMedia && 'device-showcase--duo']}>
  <div class="device-showcase__frame">
    <img
      src={desktopMedia.src}
      srcset={desktopMedia.srcset}
      sizes={sizes}
      width={desktopMedia.width ?? 800}
      height={desktopMedia.height ?? 450}
      alt={`Desktop-Ansicht: ${title}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  {mobileMedia && (
    <div
      class="device-showcase__phone"
      style={`aspect-ratio: ${mobileMedia.width} / ${mobileMedia.height}`}
    >
      <img
        src={mobileMedia.src}
        srcset={mobileMedia.srcset}
        sizes="(max-width: 900px) 34vw, 240px"
        width={mobileMedia.width}
        height={mobileMedia.height}
        alt={`Mobile Ansicht: ${title}`}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
  )}
</div>

<style>
  .device-showcase {
    position: relative;
  }

  /* Platz, damit das Smartphone unten rechts überstehen kann */
  .device-showcase--duo {
    padding-right: clamp(1.5rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }

  .device-showcase__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 17, 32, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 40px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease;
  }

  .device-showcase__frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #b8dbd9 0%, var(--c-turf) 40%, transparent 100%);
    opacity: 0.75;
    z-index: 1;
    pointer-events: none;
  }

  .device-showcase__frame img,
  .device-showcase__phone img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .device-showcase__frame img {
    transition: transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .device-showcase__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    width: clamp(6.5rem, 24%, 15rem);
    overflow: hidden;
    border-radius: clamp(1rem, 2.6vw, 2rem);
    border: clamp(4px, 0.7vw, 8px) solid #020617;
    background: #020617;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 24px 50px rgba(0, 0, 0, 0.55);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(a:hover) > .device-showcase .device-showcase__frame {
    transform: translateY(-6px);
    border-color: rgba(4, 114, 77, 0.25);
  }

  :global(a:hover) > .device-showcase .device-showcase__frame img {
    transform: scale(1.03);
  }

  :global(a:hover) > .device-showcase .device-showcase__phone {
    transform: translateY(-10px);
  }

  @media (prefers-reduced-motion: reduce) {
    .device-showcase__frame,
    .device-showcase__frame img,
    .device-showcase__phone {
      transition: none;
    }

    :global(a:hover) > .device-showcase .device-showcase__frame,
    :global(a:hover) > .device-showcase .device-showcase__frame img,
    :global(a:hover) > .device-showcase .device-showcase__phone {
      transform: none;
    }
  }
</style>
