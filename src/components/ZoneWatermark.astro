---
// Große Hintergrund-Zahl, die exakt die Höhe ihres Blocks füllt (= Höhe des Trennstrichs).
// Maße der tabellarischen Ziffern von Inter (Stärke 900) bei font-size 100:
// Breite 64.45 je Ziffer, Höhe von 73.73 über bis 0.98 unter der Grundlinie.
interface Props {
  num: string;
}

const { num } = Astro.props;
const DIGIT = 64.45;
const viewBox = `2.4 -73.73 ${(num.length * DIGIT - 4.8).toFixed(2)} 74.71`;
---

<svg class="zone-h__watermark-svg" viewBox={viewBox} preserveAspectRatio="xMinYMid meet" aria-hidden="true">
  <text x="0" y="0">{num}</text>
</svg>
