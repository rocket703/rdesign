---
import CtaBand from './CtaBand.astro';
import SketchFrame from './SketchFrame.astro';
import type { MotifName } from '../lib/sketch';
import '../styles/legal.css';
import '../styles/cards.css';
import '../styles/sub-hero.css';

type Theme = 'clean' | 'dark';
type Crumb = { label: string; href: string };

interface Props {
  title: string;
  lead: string;
  /** Teil des Titels, der wie „Ohne Baukasten.“ auf der Startseite gezeichnet unterstrichen wird */
  mark?: string;
  /** Pfad über dem Titel – „Start“ steht automatisch vorne, die aktuelle Seite hinten */
  crumbs?: Crumb[];
  /** Bezeichnung der aktuellen Seite im Pfad (Standard: Titel) */
  crumbLabel?: string;
  /** kleiner Hinweis neben dem Pfad, z. B. „In Arbeit“ */
  status?: string;
  /** Zurück-Button vor dem Pfad: Ziel und Beschriftung */
  back?: { href: string; label: string };
  wide?: boolean;
  /** volle Inhaltsbreite wie auf der Startseite (1200 px) */
  xwide?: boolean;
  legalNav?: boolean;
  /** Farbwelt: „clean“ (hell, Standard) oder „dark“ */
  theme?: Theme;
  /** nachtblauer Abschluss-Aufruf am Seitenende (Standard: an, außer auf Rechtsseiten) */
  cta?: boolean;
  /** Bleistift-Skizze im Kopf, passend zum Inhalt der Seite */
  sketch?: MotifName;
}

const {
  title,
  lead,
  mark,
  crumbs = [],
  crumbLabel = title,
  status,
  back = { href: '/', label: 'Zur Startseite' },
  wide = false,
  xwide = false,
  legalNav = true,
  theme = 'clean',
  cta = !legalNav,
  sketch,
} = Astro.props;

const trail: Crumb[] = [{ label: 'Start', href: '/' }, ...crumbs];
const markAt = mark ? title.indexOf(mark) : -1;
const hasAside = Astro.slots.has('hero');
---

<div class:list={['legal-page', `legal-page--${theme}`, wide && 'legal-page--wide', xwide && 'legal-page--xwide']}>
  <section class:list={['sub-hero', hasAside && 'sub-hero--aside']}>
    <div class="sub-hero__ambient" aria-hidden="true">
      {sketch && <img class="sub-hero__sketch" src={`/sketch/motif-${sketch}.svg`} alt="" decoding="async" />}
    </div>
    <div class="sub-hero__inner">
      <a href={back.href} class="sub-hero__back sketch-btn sketch-btn--secondary" data-page-back>
        <span aria-hidden="true">←</span> {back.label}
        <SketchFrame seed={29} />
      </a>
      <div class="sub-hero__main autoShow">
        <div class="sub-hero__top">
          <nav class="sub-hero__crumbs" aria-label="Brotkrumen">
            <ol>
              {trail.map((crumb) => (
                <li>
                  <a href={crumb.href}>{crumb.label}</a>
                </li>
              ))}
              <li><span aria-current="page">{crumbLabel}</span></li>
            </ol>
          </nav>
          {status && <span class="sub-hero__status">{status}</span>}
        </div>
        <h1 class="sub-hero__title">
          {markAt >= 0 ? (
            <Fragment>
              {title.slice(0, markAt)}<span class="sub-hero__mark">{mark}<svg class="sub-hero__underline" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2 9 C 50 5, 120 4, 237 8" />
                  <path d="M8 11.5 C 70 8, 150 8, 230 10" />
                </svg></span>{title.slice(markAt + mark!.length)}
            </Fragment>
          ) : (
            title
          )}
        </h1>
        <p class="sub-hero__lead">{lead}</p>
        <slot name="hero-main" />
      </div>
      {hasAside && (
        <div class="sub-hero__aside autoShow">
          <slot name="hero" />
        </div>
      )}
    </div>
    <!-- gezeichneter Abschluss statt Linie: zwei leicht versetzte Bleistiftstriche -->
    <svg class="sub-hero__rule" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 7 C 180 4, 360 9, 520 6 S 860 4, 1000 8" />
      <path d="M0 10 C 220 8, 420 11, 600 9 S 880 8, 1000 10" />
    </svg>
  </section>

  <section class="legal-body">
    <div class="legal-page__container">
      <slot />

      {legalNav && (
        <nav class="legal-page__nav autoShow" aria-label="Weitere rechtliche Seiten">
          <a href="/">Startseite</a>
          <a href="/kontakt/">Kontakt</a>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
      )}
    </div>
  </section>
  {cta && <CtaBand />}
</div>

<script>
  // Zurück-Button: Scrollposition per Verlauf behalten, wenn man genau vom Ziel kam.
  document.querySelectorAll<HTMLAnchorElement>('[data-page-back]').forEach((link) => {
    link.addEventListener('click', (event) => {
      try {
        const from = document.referrer ? new URL(document.referrer) : null;
        const target = new URL(link.href, location.href);
        const isExpectedBackTarget =
          from &&
          from.origin === location.origin &&
          from.pathname === target.pathname &&
          (!target.hash || from.hash === target.hash);

        if (isExpectedBackTarget && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      } catch {
        /* festes Ziel verwenden */
      }
    });
  });
</script>
