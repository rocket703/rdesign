---
import {
  DEFAULT_DRAWN_STROKES,
  pointsToDrawnPath,
  type DrawnStrokeLayer,
  type SketchPoint,
} from '../lib/drawn-stroke';

interface Props {
  points: SketchPoint[];
  layers?: DrawnStrokeLayer[];
  filter?: boolean;
}

const { points, layers = DEFAULT_DRAWN_STROKES, filter = true } = Astro.props;
---

<defs>
  <filter id="drawn-rough" x="-4%" y="-40%" width="108%" height="180%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="2" seed="4" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</defs>

<g class="drawn-strokes" filter={filter ? 'url(#drawn-rough)' : undefined}>
  {
    layers.map((layer) => (
      <path
        class="drawn-strokes__layer"
        d={pointsToDrawnPath(points, layer.dy)}
        fill="none"
        stroke={layer.color}
        stroke-width={layer.width}
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity={layer.opacity ?? 1}
        vector-effect="non-scaling-stroke"
      />
    ))
  }
</g>
