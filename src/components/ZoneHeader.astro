---
import ZoneWatermark from './ZoneWatermark.astro';

interface Props {
  variant: 'tech' | 'candy' | 'clean' | 'earth';
  num: string;
  label: string;
  title: string;
  description: string;
  titleId?: string;
}

const { variant, num, label, title, description, titleId } = Astro.props;

const hasBar = variant !== 'tech';
---

<header class:list={['zone-h', `zone-h--${variant}`, hasBar && 'zone-h--bar', 'autoShow']}>
  {hasBar ? (
    <ZoneWatermark num={num} />
  ) : (
    <span class="zone-h__watermark" aria-hidden="true">{num}</span>
  )}

  {variant === 'tech' && (
    <>
      <div class="zone-h__meta">
        <span class="zone-h__num">{num}</span>
        <span class="zone-h__label">{label}</span>
      </div>
    </>
  )}

  {variant === 'candy' && (
    <span class="zone-h__pill">{label}</span>
  )}

  {variant === 'clean' && (
    <span class="zone-h__kicker">{label}</span>
  )}

  {variant === 'earth' && (
    <span class="zone-h__stamp">{label}</span>
  )}

  <p class="zone-h__title" id={titleId}>
    <span class="zone-h__title-text">{title}</span>
  </p>
  <p class="zone-h__desc">{description}</p>
</header>
