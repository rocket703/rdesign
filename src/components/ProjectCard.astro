---
// src/components/ProjectCard.astro
// Projektkarte „Plakat“: feste Maße (340 × 470 px), überall gleich – Startseite, Projekte-Seite, Handy.
// Screenshot randlos oben, darunter großer Titel; Farben, Band und Button im Stil der Projektseite.
// Die Werte kommen aus `theme` im Projekt (src/content/projects/*.md).
import type { CollectionEntry } from 'astro:content';
import { responsiveImage } from '../lib/images';
import { isInProgress } from '../lib/project-status';

type Theme = NonNullable<CollectionEntry<'projects'>['data']['theme']>;

interface Props {
  title: string;
  description: string;
  image: string;
  id: string;
  /** Adresse der Projektseite – unten in der Karte als Domain */
  url?: string;
  headingLevel?: 2 | 3;
  status?: string;
  /** Projektart für das Band (z. B. „Vereinsseite“) */
  category?: string;
  /** Farben und Button-Stil der Projektseite */
  theme?: Theme;
}

const { title, description, image, id, url, headingLevel = 3, status = 'online', category, theme } = Astro.props;
const inProgress = isInProgress(status);
const media = responsiveImage(image, 800);

let domain = '';
try {
  domain = url ? new URL(url).hostname.replace(/^www\./, '') : '';
} catch {
  domain = '';
}

// ohne eigenes Theme: dunkle Karte in den Farben von r³webdesign
const t: Theme = theme ?? {
  bg: '#1a262c',
  text: '#ffffff',
  muted: '#c3ccd0',
  accent: '#04724d',
  accentText: '#ffffff',
  button: { bg: '#04724d', text: '#ffffff', border: 'none', radius: '8px', transform: 'none', weight: 700, tracking: 'normal', shadow: 'none', clip: 'none' },
};
const vars = [
  `--pc-bg: ${t.bg}`,
  `--pc-text: ${t.text}`,
  `--pc-muted: ${t.muted}`,
  `--pc-accent: ${t.accent}`,
  `--pc-accent-text: ${t.accentText}`,
  `--pc-btn-bg: ${t.button.bg}`,
  `--pc-btn-text: ${t.button.text}`,
  `--pc-btn-border: ${t.button.border}`,
  `--pc-btn-radius: ${t.button.radius}`,
  `--pc-btn-transform: ${t.button.transform}`,
  `--pc-btn-weight: ${t.button.weight}`,
  `--pc-btn-tracking: ${t.button.tracking}`,
  `--pc-btn-shadow: ${t.button.shadow}`,
  `--pc-btn-clip: ${t.button.clip}`,
].join('; ');
---

<a class="project-card autoShow" href={`/projekte/${id}/`} style={vars}>
  <div class="project-card__media">
    {inProgress && <span class="status-badge-wip status-badge-wip--card">In Arbeit</span>}
    <img
      src={media.src}
      srcset={media.srcset}
      sizes="340px"
      width={media.width ?? 800}
      height={media.height ?? 450}
      alt={`Vorschau von ${title}`}
      loading="lazy"
      decoding="async"
    />
  </div>
  {category && <span class="project-card__tag">{category}</span>}
  <div class="project-card__body">
    {headingLevel === 2
      ? <h2 class="project-card__title">{title}</h2>
      : <h3 class="project-card__title">{title}</h3>}
    <p class="project-card__text">{description}</p>
    <div class="project-card__foot">
      {domain && <span class="project-card__domain">{domain}</span>}
      <span class="project-card__cta">Ansehen <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>

<style>
  /* feste Maße: Breite aus dem Raster bzw. der Wischleiste (höchstens 340 px), Höhe immer 470 px */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 340px;
    height: 470px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--pc-text);
    background: var(--pc-bg);
    box-shadow:
      0 0 0 1px rgba(27, 38, 44, 0.1),
      0 26px 40px -24px rgba(27, 38, 44, 0.55);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 1px rgba(27, 38, 44, 0.1),
      0 32px 48px -24px rgba(27, 38, 44, 0.6);
  }

  .project-card:focus-visible {
    outline: 3px solid var(--pc-accent);
    outline-offset: 6px;
  }

  /* Screenshot randlos über die obere Hälfte, unten in die Kartenfarbe auslaufend */
  .project-card__media {
    position: relative;
    flex: none;
    height: 255px;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .project-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, var(--pc-bg) 100%);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  /* Band oben rechts mit umgeknickter Ecke */
  .project-card__tag {
    position: absolute;
    top: 18px;
    right: -14px;
    z-index: 2;
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--pc-accent-text);
    background: var(--pc-accent);
  }

  .project-card__tag::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    border-top: 10px solid var(--pc-accent);
    border-right: 14px solid transparent;
    filter: brightness(0.6);
  }

  .project-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding: 4px 22px 20px;
  }

  .project-card__title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--pc-text);
    text-wrap: balance;
  }

  .project-card__text {
    margin: 10px 0 14px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--pc-muted);
  }

  /* Adresse und Button unten in einer Zeile */
  .project-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--pc-text) 16%, transparent);
  }

  .project-card__domain {
    min-width: 0;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--pc-muted);
  }

  /* Button im Stil der Projektseite (Farbe, Rundung, Rahmen, Schreibweise) */
  .project-card__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    margin-left: auto;
    padding: 0 20px;
    border: var(--pc-btn-border);
    border-radius: var(--pc-btn-radius);
    clip-path: var(--pc-btn-clip);
    font-size: 0.875rem;
    font-weight: var(--pc-btn-weight);
    letter-spacing: var(--pc-btn-tracking);
    text-transform: var(--pc-btn-transform);
    color: var(--pc-btn-text);
    background: var(--pc-btn-bg);
    box-shadow: var(--pc-btn-shadow);
  }

  .project-card__cta span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-card__cta span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media img,
    .project-card__cta span {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-card__media img,
    .project-card:hover .project-card__cta span {
      transform: none;
    }
  }
</style>
