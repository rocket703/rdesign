---
// src/components/ProjectCard.astro
import { responsiveImage } from '../lib/images';
import TechIcons from './TechIcons.astro';
import { isInProgress } from '../lib/project-status';

interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  id: string;
  headingLevel?: 2 | 3;
  status?: string;
  /** Projektart für das Band (z. B. „Vereinsseite“) */
  category?: string;
  /** Position in der Liste – bestimmt die Kartenfarbe */
  accent?: number;
}

const { title, description, image, tags, id, headingLevel = 3, status = 'online', category, accent = 0 } = Astro.props;
const inProgress = isInProgress(status);
const media = responsiveImage(image, 800);
const accents = ['var(--c-turf)', 'var(--c-slate)', 'var(--c-deep)'];
const color = accents[accent % accents.length];
// mobil zeigt die Karte nur die ersten Technik-Icons in einer Reihe, der Rest als „+N“
const TECH_MOBILE = 4;
const techMore = tags.length - TECH_MOBILE;
---

<a class="project-card autoShow" href={`/projekte/${id}/`} style={`--card: ${color}`}>
  <div class="project-card__media">
    {inProgress && <span class="status-badge-wip status-badge-wip--card">In Arbeit</span>}
    <img
      src={media.src}
      srcset={media.srcset}
      sizes="(max-width: 699px) calc(100vw - 3rem), (max-width: 1100px) 50vw, 380px"
      width={media.width ?? 800}
      height={media.height ?? 450}
      alt={`Vorschau von ${title}`}
      loading="lazy"
      decoding="async"
    />
  </div>
  {category && <span class="project-card__tag">{category}</span>}
  <div class="project-card__body">
    {headingLevel === 2
      ? <h2 class="project-card__title">{title}</h2>
      : <h3 class="project-card__title">{title}</h3>}
    <p class="project-card__text">{description}</p>
    <div class="project-card__techrow">
      <TechIcons tags={tags} class="project-card__tech" />
      {techMore > 0 && <span class="project-card__more" aria-hidden="true">+{techMore}</span>}
    </div>
  </div>
  <span class="project-card__cta">Projekt ansehen <span aria-hidden="true">→</span></span>
</a>

<style>
  /* Karte mit asymmetrischen Ecken und Bändern, die über den Rand ragen */
  .project-card {
    --card: var(--c-turf);
    --r-big: 56px;
    --r-small: 10px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--r-big) var(--r-small) var(--r-big) var(--r-small);
    text-decoration: none;
    color: var(--c-ink);
    background: #ffffff;
    box-shadow:
      10px 12px 0 -2px rgba(34, 50, 58, 0.08),
      0 18px 36px -16px rgba(34, 50, 58, 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow:
      12px 16px 0 -2px rgba(34, 50, 58, 0.1),
      0 26px 44px -18px rgba(34, 50, 58, 0.45);
  }

  .project-card:focus-visible {
    outline: 3px solid var(--card);
    outline-offset: 6px;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-big) var(--r-small) 0 0;
    background: var(--c-bg);
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  /* Band rechts mit umgeknickter Ecke */
  .project-card__tag {
    position: relative;
    align-self: flex-end;
    margin: -1rem -18px 0 0;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ffffff;
    background: var(--card);
  }

  .project-card__tag::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    border-top: 12px solid var(--card);
    border-right: 18px solid transparent;
    filter: brightness(0.65);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.1rem 1.4rem 1rem;
  }

  .project-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--card);
  }

  .project-card__text {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--c-slate);
  }

  .project-card__techrow {
    margin-top: 0.85rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--c-line);
  }

  .project-card :global(.project-card__tech) {
    --tech-icon-bg: transparent;
    --tech-icon-border: var(--c-line);
    --tech-icon-color: var(--c-slate);
    min-width: 0;
  }

  .project-card__more {
    display: none;
    place-items: center;
    flex: none;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: 9px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--c-slate);
    border: 1px dashed var(--c-line);
  }

  /* Mobil (Wischleisten): Karte kompakter, damit sie ganz auf den Bildschirm passt –
     flacheres Vorschaubild, Text max. 3 Zeilen, Technik in einer Reihe */
  @media (max-width: 819px) {
    .project-card__media {
      aspect-ratio: 16 / 9;
    }

    .project-card__body {
      padding: 1rem 1.25rem 0.75rem;
    }

    .project-card__title {
      font-size: 1.15rem;
    }

    .project-card__text {
      /* nicht strecken, sonst greift die 3-Zeilen-Begrenzung nicht; Rest füllt der Platz darunter */
      flex: none;
      margin-bottom: auto;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .project-card :global(.project-card__tech) {
      flex-wrap: nowrap;
      overflow: hidden;
    }

    .project-card :global(.project-card__tech .tech-icons__item:nth-child(n + 5)) {
      display: none;
    }

    .project-card__more {
      display: grid;
    }

    .project-card__cta {
      margin: 0.25rem 0 1.5rem -18px;
    }
  }

  /* Band unten links mit umgeknickter Ecke */
  .project-card__cta {
    position: relative;
    align-self: flex-start;
    margin: 0.5rem 0 2.25rem -18px;
    padding: 0.6rem 1.25rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--card);
  }

  .project-card__cta::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    border-bottom: 12px solid var(--card);
    border-left: 18px solid transparent;
    filter: brightness(0.65);
  }

  .project-card__cta span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-card__cta span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media img,
    .project-card__cta span {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-card__media img,
    .project-card:hover .project-card__cta span {
      transform: none;
    }
  }
</style>
