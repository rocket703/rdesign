---
import DrawnStrokes from './DrawnStrokes.astro';
import {
  DEFAULT_DRAWN_STROKES,
  HERO_FLOOR_VIEWBOX,
  pointsToFillPolygon,
  sketchHorizontalPoints,
} from '../lib/drawn-stroke';

const edge = sketchHorizontalPoints();
const fillPoints = pointsToFillPolygon(edge, 1440, 72);
---

<div class="hero-floor-seam" aria-hidden="true">
  <svg class="hero-floor-seam__svg" viewBox={HERO_FLOOR_VIEWBOX} preserveAspectRatio="none">
    <polygon class="hero-floor-seam__fill" points={fillPoints} fill="var(--p-tech-bg)" />
    <DrawnStrokes points={edge} layers={DEFAULT_DRAWN_STROKES} />
  </svg>
</div>
