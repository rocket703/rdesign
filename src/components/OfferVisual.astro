---
// Kleine Live-Vorschau je Angebot (rein dekorativ)
import type { OfferIcon } from '../data/offers';

interface Props {
  name: OfferIcon;
}

const { name } = Astro.props;
const scoreRadius = 30;
const scoreLength = 2 * Math.PI * scoreRadius;
---

<div class:list={['offer-visual', `offer-visual--${name}`]} aria-hidden="true">
  {name === 'search' && (
    <div class="ov-seo">
      <svg class="ov-seo__ring" viewBox="0 0 72 72" style={`--len: ${scoreLength.toFixed(1)}`}>
        <circle cx="36" cy="36" r={scoreRadius} class="ov-seo__track" />
        <circle cx="36" cy="36" r={scoreRadius} class="ov-seo__value" />
        <text x="36" y="41" text-anchor="middle">98</text>
      </svg>
      <ul class="ov-seo__bars">
        <li><span>Ladezeit</span><i style="--w: 96%"></i></li>
        <li><span>Mobil</span><i style="--w: 100%"></i></li>
        <li><span>Technik</span><i style="--w: 92%"></i></li>
      </ul>
    </div>
  )}

  {name === 'refresh' && (
    <div class="ov-relaunch">
      <div class="ov-relaunch__page ov-relaunch__page--old">
        <i class="w60"></i><i class="w90"></i><i class="w40"></i><i class="w80"></i><i class="w70"></i>
      </div>
      <div class="ov-relaunch__page ov-relaunch__page--new">
        <i class="hero"></i><i class="w70"></i><i class="btn"></i>
      </div>
      <span class="ov-relaunch__handle"></span>
      <span class="ov-relaunch__label ov-relaunch__label--old">Vorher</span>
      <span class="ov-relaunch__label ov-relaunch__label--new">Nachher</span>
    </div>
  )}

  {name === 'access' && (
    <div class="ov-a11y">
      <span class="ov-a11y__sample">Aa</span>
      <div class="ov-a11y__meta">
        <span class="ov-a11y__ratio">7,2 : 1</span>
        <span class="ov-a11y__badge">WCAG AA ✓</span>
      </div>
    </div>
  )}
</div>

<style>
  .offer-visual {
    position: relative;
    display: grid;
    place-items: center;
    height: 7.5rem;
    margin-bottom: 1.25rem;
    overflow: hidden;
    border-radius: 10px;
    background:
      radial-gradient(circle at 20% 0%, rgba(52, 211, 153, 0.18), transparent 60%),
      linear-gradient(160deg, #f0fdf8 0%, #f8fafc 100%);
    border: 1px solid rgba(16, 185, 129, 0.14);
  }

  /* ── SEO: Score-Ring + Balken ── */
  .ov-seo {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .ov-seo__ring {
    width: 4.5rem;
    height: 4.5rem;
    transform: rotate(-90deg);
  }

  .ov-seo__ring circle {
    fill: none;
    stroke-width: 7;
  }

  .ov-seo__track {
    stroke: rgba(16, 185, 129, 0.15);
  }

  .ov-seo__value {
    stroke: #10b981;
    stroke-linecap: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    transition: stroke-dashoffset 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s;
  }

  .ov-seo__ring text {
    transform: rotate(90deg);
    transform-origin: 36px 36px;
    font-size: 19px;
    font-weight: 900;
    fill: #065f46;
  }

  .ov-seo__bars {
    display: grid;
    gap: 0.4rem;
    width: 6.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ov-seo__bars li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.62rem;
    font-weight: 700;
    color: #475569;
  }

  .ov-seo__bars i {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #10b981, #34d399) 0 0 / 0 100% no-repeat, rgba(16, 185, 129, 0.15);
    transition: background-size 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s;
  }

  :global(.is-visible) .ov-seo__value {
    stroke-dashoffset: calc(var(--len) * 0.02);
  }

  :global(.is-visible) .ov-seo__bars i {
    background-size: var(--w) 100%, auto;
  }

  /* ── Relaunch: Vorher/Nachher ── */
  .ov-relaunch {
    --split: 50%;
    position: absolute;
    inset: 0.9rem 1.2rem;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: #fff;
  }

  .ov-relaunch__page {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.6rem 0.7rem;
  }

  .ov-relaunch__page i {
    display: block;
    height: 0.4rem;
    border-radius: 1px;
  }

  .ov-relaunch__page--old {
    background: #e7e5e4;
  }

  .ov-relaunch__page--old i {
    background: #a8a29e;
  }

  .ov-relaunch__page--new {
    clip-path: inset(0 0 0 var(--split));
    background: #ffffff;
    transition: clip-path 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ov-relaunch__page--new i {
    border-radius: 3px;
    background: #cbd5e1;
  }

  .ov-relaunch__page--new .hero {
    height: 1.6rem;
    background: linear-gradient(120deg, #10b981, #38bdf8);
  }

  .ov-relaunch__page--new .btn {
    width: 32%;
    height: 0.55rem;
    background: #0f172a;
  }

  .w40 { width: 40%; }
  .w60 { width: 60%; }
  .w70 { width: 70%; }
  .w80 { width: 80%; }
  .w90 { width: 90%; }

  .ov-relaunch__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: #10b981;
    transition: left 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ov-relaunch__handle::after {
    content: '⇆';
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.7rem;
    color: #fff;
    background: #10b981;
    transform: translate(-50%, -50%);
  }

  .ov-relaunch__label {
    position: absolute;
    bottom: 0.35rem;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
  }

  .ov-relaunch__label--old { left: 0.5rem; }
  .ov-relaunch__label--new { right: 0.5rem; color: #047857; }

  :global(a:hover) .ov-relaunch,
  :global(a:focus-visible) .ov-relaunch {
    --split: 18%;
  }

  /* ── Barrierefreiheit: Kontrast-Prüfer ── */
  .ov-a11y {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ov-a11y__sample {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 10px;
    font-size: 1.9rem;
    font-weight: 900;
    color: #ffffff;
    background: #0f172a;
    outline: 3px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.3s ease;
  }

  .ov-a11y__meta {
    display: grid;
    gap: 0.35rem;
  }

  .ov-a11y__ratio {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #0f172a;
  }

  .ov-a11y__badge {
    justify-self: start;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
    background: #047857;
  }

  :global(a:hover) .ov-a11y__sample,
  :global(a:focus-visible) .ov-a11y__sample {
    outline-color: #f59e0b;
  }

  @media (prefers-reduced-motion: reduce) {
    .ov-seo__value,
    .ov-seo__bars i,
    .ov-relaunch__page--new,
    .ov-relaunch__handle,
    .ov-a11y__sample {
      transition: none;
    }

    .ov-seo__value {
      stroke-dashoffset: calc(var(--len) * 0.02);
    }

    .ov-seo__bars i {
      background-size: var(--w) 100%, auto;
    }
  }
</style>
