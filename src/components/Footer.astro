---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- gezeichneter Strich als Abschluss über dem Footer -->
  <svg class="footer-rule" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 7 C 160 5, 380 9, 540 6 S 840 5, 1000 8" />
  </svg>
  <div class="footer-body">
    <div class="footer-grid">
      <div class="item-left">
        <p class="f-badge">
          <span class="f-badge__dot" aria-hidden="true"></span>
          Webdesign aus Magdeburg
        </p>
      </div>
      <div class="item-center">
        <a href="/" class="f-logo" aria-label="r³webdesign – zur Startseite">
          <img src="/sketch/hero-logo.svg" width="398" height="108" alt="" loading="lazy" decoding="async" />
        </a>
        <p class="f-slogan">Design. Entwicklung. Betreuung.</p>
      </div>
      <div class="item-right">
        <nav class="f-nav" aria-label="Rechtliches">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
        <p class="f-copy">© {currentYear}</p>
      </div>
    </div>
  </div>

  <div class="footer-visual-bottom" aria-hidden="true">
    <div class="huge-outline-text">
      r<span class="wm-sup">3</span>webdesign
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Sichtbar: 50 % Schrifthöhe; leicht nach oben versetzt */
    --footer-watermark-size: clamp(3.25rem, 18vw, 14rem);
    --footer-watermark-lh: 0.85;
    --footer-peek-visible: 0.5;
    --footer-superscript-pad: calc(var(--footer-watermark-size) * 0.11);
    --footer-text-top: calc(var(--footer-superscript-pad) - var(--footer-watermark-size) * 0.055);
    --footer-peek-h: calc(
      var(--footer-watermark-size) * var(--footer-watermark-lh) * var(--footer-peek-visible) + var(--footer-superscript-pad)
    );
    position: relative;
    background-color: var(--c-deep);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .footer-rule {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 14px;
    overflow: visible;
  }

  .footer-rule path {
    fill: none;
    stroke: rgba(184, 219, 217, 0.45);
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .footer-body {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2rem) clamp(2rem, 4vw, 3rem);
    box-sizing: border-box;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .item-left {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .item-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    min-width: 0;
  }

  .item-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 0.5rem;
    text-align: right;
  }

  /* Bleistift-Logo wie im Hero der Startseite */
  .f-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: transform 0.25s ease;
  }

  /* Bleistift-Logo hell nachgezogen, damit es auf dem dunklen Grund steht */
  .f-logo img {
    width: clamp(200px, 22vw, 280px);
    height: auto;
    filter: invert(1) brightness(1.15);
  }

  .f-logo:hover {
    transform: rotate(-0.8deg);
  }

  .f-slogan {
    color: var(--c-sky);
    font-size: clamp(0.8rem, 2.2vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.45;
    margin: 0;
    white-space: nowrap;
  }

  .f-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    border: 1px solid #334155;
    padding: 6px 14px;
    border-radius: 50px;
    white-space: nowrap;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .f-badge:hover {
    border-color: var(--c-sky);
    background: rgba(184, 219, 217, 0.05);
  }

  .f-badge__dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    background: var(--c-turf);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--c-turf);
  }

  .f-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: flex-end;
  }

  .f-nav a {
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: clamp(0.75rem, 1.8vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .f-nav a:hover {
    color: var(--c-sky);
  }

  .f-copy {
    color: #94a3b8;
    font-size: 0.75rem;
    font-family: inherit;
    margin: 0;
    line-height: 1.4;
  }

  /* Wasserzeichen – obere Hälfte der Schrift sichtbar */
  .footer-visual-bottom {
    flex-shrink: 0;
    width: 100%;
    height: var(--footer-peek-h);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    line-height: 0;
  }

  .huge-outline-text {
    position: absolute;
    left: 50%;
    top: var(--footer-text-top);
    margin: 0;
    padding: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: var(--footer-watermark-size);
    font-weight: 900;
    line-height: var(--footer-watermark-lh);
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(184, 219, 217, 0.14);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    transform: translateX(-50%);
  }

  .wm-sup {
    font-size: 0.52em;
    vertical-align: super;
    line-height: 0;
    -webkit-text-stroke: inherit;
  }

  @media (max-width: 1023px) {
    .site-footer {
      --footer-watermark-size: clamp(3.25rem, 20vw, 6rem);
      --footer-superscript-pad: calc(var(--footer-watermark-size) * 0.06);
      --footer-text-top: calc(var(--footer-watermark-size) * -0.045);
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .item-left,
    .item-right {
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .f-nav {
      justify-content: center;
    }

    .f-slogan {
      white-space: normal;
      max-width: 22rem;
    }

    /* Mobil kompakter: Badge entfällt, Logo und Slogan rücken zusammen */
    .item-left {
      display: none;
    }

    .footer-body {
      padding-top: clamp(2rem, 6vw, 2.75rem);
    }

    .footer-grid {
      gap: 1.25rem;
    }

    .item-center {
      gap: 0.1rem;
    }
  }

  @media (max-width: 480px) {
    .f-badge {
      font-size: 0.75rem;
      padding: 6px 10px;
    }

    .site-footer {
      --footer-watermark-size: 3.25rem;
      --footer-superscript-pad: calc(var(--footer-watermark-size) * 0.05);
      --footer-text-top: calc(var(--footer-watermark-size) * -0.055);
    }

    .footer-body {
      padding-bottom: 1.5rem;
    }

    .footer-grid {
      gap: 1.5rem;
    }

    .huge-outline-text {
      -webkit-text-stroke-width: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .huge-outline-text {
      transform: translateX(-50%);
      transition: none;
    }

  }
</style>
