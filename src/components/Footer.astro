---
import fs from 'node:fs';
import path from 'node:path';
import { SITE } from '../lib/seo';

const currentYear = new Date().getFullYear();
// Wortmarke (r³ + webdesign) als Umriss fürs große Wasserzeichen unten
const wordmarkPath = fs
  .readFileSync(path.join(process.cwd(), 'public', 'logo-header.svg'), 'utf8')
  .match(/ d="([^"]+)"/)![1];
---

<footer class="site-footer">
  <!-- gezeichneter Strich als Abschluss über dem Footer -->
  <svg class="footer-rule" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 7 C 160 5, 380 9, 540 6 S 840 5, 1000 8" />
  </svg>
  <div class="footer-body">
    <div class="footer-grid">
      <div class="item-left">
        <p class="f-badge">
          <span class="f-badge__dot" aria-hidden="true"></span>
          Webdesign aus Magdeburg
        </p>
      </div>
      <div class="item-center">
        <a href="/" class="f-logo" aria-label="r³webdesign – zur Startseite">
          <img src="/sketch/hero-logo.svg" width="398" height="108" alt="" loading="lazy" decoding="async" />
        </a>
        <p class="f-slogan">Design. Entwicklung. Betreuung.</p>
      </div>
      <div class="item-right">
        <a class="f-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <nav class="f-nav" aria-label="Footer">
          <a href="/kontakt/">Kontakt</a>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
        <p class="f-copy">© {currentYear}</p>
      </div>
    </div>
  </div>

  <div class="footer-visual-bottom" aria-hidden="true">
    <!-- r³ und „webdesign“ gleich hoch: derselbe Pfad zweimal, einmal aufs Zeichen, einmal auf die
         Schrift zugeschnitten und hochskaliert (Schrift im Original: x 125.45–389.88, y 30.01–75.96) -->
    <svg class="footer-wordmark" viewBox="-2 -2 705 104" aria-hidden="true">
      <defs>
        <clipPath id="wm-mark" clipPathUnits="userSpaceOnUse"><rect x="-5" y="-5" width="115" height="110" /></clipPath>
        <clipPath id="wm-text" clipPathUnits="userSpaceOnUse"><rect x="115" y="-5" width="290" height="110" /></clipPath>
      </defs>
      <path d={wordmarkPath} clip-path="url(#wm-mark)" />
      <g transform="translate(125.4 0) scale(2.1764) translate(-125.45 -30.01)">
        <path d={wordmarkPath} clip-path="url(#wm-text)" />
      </g>
    </svg>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--c-deep);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .footer-rule {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 14px;
    overflow: visible;
  }

  .footer-rule path {
    fill: none;
    stroke: rgba(184, 219, 217, 0.45);
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .footer-body {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2rem) clamp(2rem, 4vw, 3rem);
    box-sizing: border-box;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .item-left {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .item-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    min-width: 0;
  }

  .item-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 0.5rem;
    text-align: right;
  }

  /* Bleistift-Logo wie im Hero der Startseite */
  .f-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: transform 0.25s ease;
  }

  /* Bleistift-Logo hell nachgezogen, damit es auf dem dunklen Grund steht */
  .f-logo img {
    width: clamp(200px, 22vw, 280px);
    height: auto;
    filter: invert(1) brightness(1.15);
  }

  .f-logo:hover {
    transform: rotate(-0.8deg);
  }

  .f-slogan {
    color: var(--c-sky);
    font-size: clamp(0.8rem, 2.2vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.45;
    margin: 0;
    white-space: nowrap;
  }

  .f-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    border: 1px solid #334155;
    padding: 6px 14px;
    border-radius: 50px;
    white-space: nowrap;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .f-badge:hover {
    border-color: var(--c-sky);
    background: rgba(184, 219, 217, 0.05);
  }

  .f-badge__dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    background: var(--c-turf);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--c-turf);
  }

  .f-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: flex-end;
  }

  .f-nav a {
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: clamp(0.75rem, 1.8vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .f-nav a:hover {
    color: var(--c-sky);
  }

  .f-mail {
    color: var(--c-sky);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .f-mail:hover {
    color: #fff;
  }

  .f-copy {
    color: #94a3b8;
    font-size: 0.75rem;
    font-family: inherit;
    margin: 0;
    line-height: 1.4;
  }

  /* Wasserzeichen – obere Hälfte der Schrift sichtbar */
  .footer-visual-bottom {
    flex-shrink: 0;
    width: 100%;
    /* Höhe der Wortmarke = Breite × 104 / 705; davon gut die Hälfte sichtbar */
    height: calc(min(92vw, 1100px) * 0.1475 * 0.55);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    line-height: 0;
  }

  /* Wortmarke als Umriss, r³ und Schrift gleich hoch – gut die Hälfte schaut heraus */
  .footer-wordmark {
    --wm-w: min(92vw, 1100px);
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--wm-w);
    height: auto;
    overflow: visible;
    translate: -50% 0;
    pointer-events: none;
  }

  .footer-wordmark path {
    fill: none;
    stroke: rgba(184, 219, 217, 0.16);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .item-left,
    .item-right {
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .f-nav {
      justify-content: center;
    }

    .f-slogan {
      white-space: normal;
      max-width: 22rem;
    }

    /* Mobil kompakter: Badge entfällt, Logo und Slogan rücken zusammen */
    .item-left {
      display: none;
    }

    .footer-body {
      padding-top: clamp(2rem, 6vw, 2.75rem);
    }

    .footer-grid {
      gap: 1.25rem;
    }

    .item-center {
      gap: 0.1rem;
    }
  }

  @media (max-width: 480px) {
    .f-badge {
      font-size: 0.75rem;
      padding: 6px 10px;
    }

    .footer-body {
      padding-bottom: 1.5rem;
    }

    .footer-grid {
      gap: 1.5rem;
    }

  }

</style>
