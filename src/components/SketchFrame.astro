---
// Gekritzelter Bleistift-Rahmen um Buttons, Karten oder Icons (Farbe über `color` bzw. --frame)
import { sketchFrame, frameShapes, type FrameShape } from '../lib/sketch';

interface Props {
  seed?: number;
  shape?: FrameShape;
}

const { seed = 1, shape = 'button' } = Astro.props;
const { w, h } = frameShapes[shape];
---
<svg class:list={['sketch-frame', `sketch-frame--${shape}`]} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true" set:html={sketchFrame(seed, shape)} />
