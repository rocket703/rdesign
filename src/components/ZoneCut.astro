---
import {
  type CutVariant,
  cutFillPath,
  cutFillPoints,
  cutStrokePath,
  cutUsesCurve,
  CUT_VIEWBOX,
} from '../lib/zone-cut-paths';

interface Props {
  variant: CutVariant;
  fill: string;
  accent: string;
  front?: string;
}

const { variant, fill, accent, front = '#f8fafc' } = Astro.props;

const fillPath = cutFillPath(variant);
const fillPoints = cutFillPoints(variant);
const isCurve = cutUsesCurve(variant);
const isDrop = variant === 'drop';
const mainLine = cutStrokePath(variant, 0);
const highlightLine = cutStrokePath(variant, isCurve ? -2 : -5);
---

<div class={`zone-cut zone-cut--${variant}`} aria-hidden="true">
  <svg class="zone-cut__svg" viewBox={CUT_VIEWBOX} preserveAspectRatio="none">
    {
      fillPath ? (
        <path
          class="zone-cut__fill"
          d={fillPath}
          fill={isDrop ? front : fill}
        />
      ) : fillPoints ? (
        <polygon class="zone-cut__fill" points={fillPoints} fill={fill} />
      ) : null
    }
    {
      !isCurve && (
        <path
          class="zone-cut__accent"
          d={mainLine}
          fill="none"
          stroke={accent}
          stroke-width="3.5"
          stroke-linecap="square"
          stroke-linejoin="miter"
          vector-effect="non-scaling-stroke"
        />
      )
    }
    {
      !isCurve && (
        <path
          class="zone-cut__highlight"
          d={highlightLine}
          fill="none"
          stroke={front}
          stroke-width="1.5"
          stroke-linecap="square"
          stroke-linejoin="miter"
          vector-effect="non-scaling-stroke"
        />
      )
    }
    {
      isDrop && (
        <path
          class="zone-cut__drop-line"
          d={mainLine}
          fill="none"
          stroke={accent}
          stroke-width="1.5"
          stroke-opacity="0.7"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        />
      )
    }
  </svg>
</div>
