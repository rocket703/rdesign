---
// Abschluss-Aufruf auf mintfarbenem Rasterpapier – leitet in den Footer über
import SketchFrame from './SketchFrame.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Bereit für deine neue Webseite?',
  text = 'Erzähl mir kurz von deinem Vorhaben – das Erstgespräch ist kostenlos und unverbindlich. Antwort meist innerhalb von 24 Stunden.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <svg class="cta-band__rule" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 6 C 200 9, 380 4, 560 7 S 860 9, 1000 5" />
    <path d="M0 9 C 240 11, 440 7, 620 9 S 880 11, 1000 8" />
  </svg>
  <div class="cta-band__inner">
    <div>
      <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
      <p class="cta-band__text">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href="/kontakt/" class="sketch-btn sketch-btn--primary">Projekt anfragen<SketchFrame seed={71} /></a>
      <a href="/projekte/" class="sketch-btn sketch-btn--secondary">Projekte ansehen<SketchFrame seed={73} /></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    z-index: 2;
    padding: clamp(3.5rem, 8vw, 5rem) 1.5rem;
    /* Mint wie die Ablauf-Sektion: setzt sich vom weißen Papier davor und dahinter ab */
    background-color: var(--c-sky);
    background-image:
      repeating-linear-gradient(0deg, rgba(31, 60, 64, 0.1) 0 1px, transparent 1px 36px),
      repeating-linear-gradient(90deg, rgba(31, 60, 64, 0.1) 0 1px, transparent 1px 36px);
    background-position: center;
    color: var(--c-ink);
  }

  /* gezeichneter Strich als Übergang vom Inhalt */
  .cta-band__rule {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 14px;
    overflow: visible;
  }

  .cta-band__rule path {
    fill: none;
    stroke: #1f2428;
    stroke-width: 1.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .cta-band__rule path + path {
    stroke-width: 1;
    opacity: 0.55;
  }

  .cta-band__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  .cta-band__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .cta-band__text {
    max-width: 56ch;
    margin: 0;
    line-height: 1.65;
    color: var(--c-on-sky);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
  }

  .cta-band__actions .sketch-btn {
    min-height: 48px;
    padding-block: 0;
  }
</style>
