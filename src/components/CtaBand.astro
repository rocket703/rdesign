---
// Nachtblauer Abschluss-Aufruf (Akzent-Hintergrund 1) – leitet in den Footer über
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Bereit für deine neue Webseite?',
  text = 'Erzähl mir kurz von deinem Vorhaben – das Erstgespräch ist kostenlos und unverbindlich. Antwort meist innerhalb von 24 Stunden.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="cta-band__inner">
    <div>
      <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
      <p class="cta-band__text">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href="/kontakt/" class="cta-band__btn">Projekt anfragen</a>
      <a href="/projekte/" class="cta-band__btn cta-band__btn--ghost">Projekte ansehen</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    z-index: 2;
    padding: clamp(3.5rem, 8vw, 5rem) 1.5rem calc(clamp(3.5rem, 8vw, 5rem) + 1.5rem);
    background:
      radial-gradient(ellipse 50% 70% at 0% 0%, rgba(184, 219, 217, 0.2), transparent 60%),
      radial-gradient(ellipse 40% 60% at 100% 100%, rgba(184, 219, 217, 0.12), transparent 60%),
      var(--c-dark);
    color: #f8fafc;
  }

  .cta-band__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  .cta-band__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .cta-band__text {
    max-width: 56ch;
    margin: 0;
    line-height: 1.65;
    color: #cbd5e1;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border: 2px solid var(--c-green);
    border-radius: 10px;
    font-weight: 800;
    text-decoration: none;
    color: #ffffff;
    background: var(--c-turf);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-band__btn:hover {
    background: var(--c-turf-hover);
    transform: translateY(-2px);
  }

  .cta-band__btn--ghost {
    color: #f8fafc;
    background: transparent;
    border-color: rgba(248, 250, 252, 0.5);
  }

  .cta-band__btn--ghost:hover {
    background: rgba(248, 250, 252, 0.08);
  }

  .cta-band__btn:focus-visible {
    outline: 2px solid var(--c-gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-band__btn {
      transition: none;
    }

    .cta-band__btn:hover {
      transform: none;
    }
  }
</style>
