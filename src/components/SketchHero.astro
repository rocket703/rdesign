---
// Hero im Bleistift-Look: Rasterpapier, Wireframe-Skizzen in den Ecken, Logo als Umriss.
// Die Skizzen kommen als statische SVGs aus src/pages/sketch/[name].svg.ts.
import SketchFrame from './SketchFrame.astro';

// Maße entsprechen dem viewBox der jeweiligen Skizze – verhindert Layout Shift.
const corners = [
  { c: 'tl', w: 460, h: 420 },
  { c: 'tr', w: 480, h: 440 },
  { c: 'bl', w: 460, h: 400 },
  { c: 'br', w: 460, h: 400 },
] as const;
---
<header class="sketch-hero" id="intro">
  <div class="sketch-hero__paper" aria-hidden="true">
    {corners.map(({ c, w, h }) => (
      <img class={`sketch-hero__corner sketch-hero__corner--${c}`} src={`/sketch/corner-${c}.svg`} width={w} height={h} alt="" decoding="async" />
    ))}
  </div>

  <div class="sketch-hero__inner">
    <h1 class="sketch-hero__logo">
      <span class="sr-only">r³webdesign – Webdesign &amp; Webentwicklung in Magdeburg</span>
      <img src="/sketch/hero-logo.svg" width="398" height="108" alt="" fetchpriority="high" />
    </h1>

    <p class="sketch-hero__value">
      <span class="sketch-hero__line">Klar&nbsp;gestaltet.</span> <span class="sketch-hero__line">Schnell&nbsp;geladen.</span> <span class="sketch-hero__mark">Ohne&nbsp;Baukasten.<svg class="sketch-hero__underline" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true">
          <path d="M2 9 C 50 5, 120 4, 237 8" />
          <path d="M8 11.5 C 70 8, 150 8, 230 10" />
        </svg></span>
    </p>
    <p class="sketch-hero__sub">Webseiten für Vereine, Events und lokale Unternehmen in Magdeburg und Umgebung.</p>

    <div class="sketch-hero__actions">
      <a href="/kontakt/" class="sketch-btn sketch-btn--primary">Projekt anfragen<SketchFrame seed={11} fill /></a>
      <a href="#projekte" class="sketch-btn sketch-btn--secondary">Projekte ansehen<SketchFrame seed={23} /></a>
    </div>
  </div>
</header>

<style>
  .sketch-hero {
    --ink: #1f2428;
    --pencil: #4a5056;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    /* unter den transparenten Header ziehen: Papier läuft bis an den oberen Rand */
    margin-top: calc(-1 * var(--site-header-height));
    min-height: 100svh;
    padding: calc(var(--site-header-height) + clamp(1.5rem, 5vh, 3.5rem)) 1rem clamp(2rem, 6vh, 4rem);
    background-color: var(--c-sketch-paper);
    color: var(--ink);
  }

  /* Rasterpapier, Mitte etwas aufgehellt */
  .sketch-hero__paper {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 42% 38% at 50% 48%, rgba(255, 255, 255, 0.35), transparent 75%),
      repeating-linear-gradient(0deg, rgba(60, 68, 76, 0.09) 0 1px, transparent 1px 36px),
      repeating-linear-gradient(90deg, rgba(60, 68, 76, 0.09) 0 1px, transparent 1px 36px);
    background-position: center;
  }

  .sketch-hero__corner {
    position: absolute;
    width: clamp(220px, 30vw, 460px);
    height: auto;
    opacity: 0.75;
    user-select: none;
  }
  .sketch-hero__corner--tl { top: 6%;  left: -1%; }
  .sketch-hero__corner--tr { top: 9%; right: -3%; }
  .sketch-hero__corner--bl { bottom: -6%; left: -6%; }
  .sketch-hero__corner--br { bottom: -4%; right: -5%; }

  .sketch-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 72rem;
  }

  .sketch-hero__logo {
    margin: 0 0 clamp(2.5rem, 8vh, 5rem);
    line-height: 0;
  }
  .sketch-hero__logo img {
    width: clamp(260px, 42vw, 480px);
    height: auto;
    /* schmaler Papier-Rand direkt an den Umrisslinien: Skizzenstriche brechen
       kurz vor den Buchstaben ab, statt durch sie zu schneiden */
    filter:
      drop-shadow(0 0 1px var(--c-sketch-paper))
      drop-shadow(0 0 1.5px var(--c-sketch-paper))
      drop-shadow(0 0 2px var(--c-sketch-paper));
    animation: sketch-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .sketch-hero__value {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 2.7vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .sketch-hero__mark {
    position: relative;
    white-space: nowrap;
  }

  /* Einzeichnen über clip-path statt Strich-Dash: pathLength + non-scaling-stroke
     zeichnet in Chrome bei breiten Viewports nicht bis zum Ende */
  .sketch-hero__underline {
    position: absolute;
    left: -2%;
    bottom: -0.32em;
    width: 104%;
    height: 0.35em;
    overflow: visible;
    clip-path: inset(-50% 100% -50% 0);
    animation: sketch-draw 0.8s 0.6s ease-out forwards;
  }
  .sketch-hero__underline path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .sketch-hero__underline path + path {
    stroke-width: 1;
    opacity: 0.55;
  }

  .sketch-hero__sub {
    margin: 0 0 2rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: #3d4449;
    text-wrap: balance;
  }

  .sketch-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  @keyframes sketch-in {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
  }
  @keyframes sketch-draw {
    to { clip-path: inset(-50% -2% -50% 0); }
  }

  /* Mobil: Skizzen kleiner und blasser, damit der Text vorne bleibt */
  @media (max-width: 700px) {
    .sketch-hero__corner { width: 46vw; opacity: 0.45; }
    .sketch-hero__corner--tl { top: 9%; left: -14%; }
    .sketch-hero__corner--tr { top: 8%; right: -16%; }
    .sketch-hero__corner--bl { bottom: -3%; left: -16%; }
    .sketch-hero__corner--br { bottom: -2%; right: -18%; }
    .sketch-hero__logo { margin-bottom: 2.5rem; }
    /* jeder Satz eine eigene Zeile – nicht je nach Gerät mal zwei, mal drei */
    .sketch-hero__line { display: block; }
    /* 15 px: Unterzeile bleibt ab 360 px Breite zweizeilig */
    .sketch-hero__sub { font-size: 0.9375rem; }
    .sketch-hero__logo img { width: min(84vw, 360px); }
    .sketch-hero__actions { flex-direction: column; align-items: stretch; width: min(100%, 18rem); }
    .sketch-btn { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sketch-hero__logo img { animation: none; }
    .sketch-hero__underline { animation: none; clip-path: none; }
  }
</style>
