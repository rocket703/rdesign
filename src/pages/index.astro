---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects, projectSlug } from '../lib/projects';
import { faqItems } from '../data/faq';
import ZoneCut from '../components/ZoneCut.astro';
import ZoneHeader from '../components/ZoneHeader.astro';
import TechSeam from '../components/TechSeam.astro';
import StyleShowcase from '../components/StyleShowcase.astro';
import CandyTapeDivider from '../components/CandyTapeDivider.astro';
import { BIOME_META, EARTH_META } from '../data/portfolio-biomes';
import '../styles/home-world.css';

import { homePageSchema, SITE } from '../lib/seo';


const candyMarqueeWords = [
  'Laut',
  'Bunt',
  'Menschlich',
  'Pop statt PowerPoint',
  'Events',
  'Bands',
  'Marken',
  'Magdeburg',
  'Creative Energy',
  'Kein Bullshit',
] as const;

const publishedProjects = await getPublishedProjects();

const featuredSlugs = ['startplatzboerse', 'ohrelauf', 'radsportclub-magdeburg'];
const featuredProjects = featuredSlugs
  .map((slug) => publishedProjects.find((project) => projectSlug(project) === slug))
  .filter((project): project is (typeof publishedProjects)[number] => Boolean(project));

---

<BaseLayout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  jsonLd={homePageSchema(faqItems, Astro.site)}
>
<article class="p-world home-world">
  <!-- ═══ 01 TECHNICAL ═══ -->
  <div class="p-zone p-zone--tech">
    <header class="p-tech-hero" id="intro">
      <div class="hero-ambient" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-spotlight"></div>
      </div>

      <div class="p-tech-hero__inner">
        <div class="p-tech-hero__brand intro">
          <p class="p-tech-hero__zone-label">01 / Technical</p>
          <div class="section-head hero-brand">
            <h1 class="r3-logo">
              <span class="hero-terminal is-booting" data-phase="deployed" aria-hidden="true">
                <span class="hero-terminal__prompt">&gt;_</span>
                <span class="hero-terminal__cmd">r³</span>
                <span class="hero-terminal__cursor"></span>
                <span class="hero-terminal__status">
                  <span class="hero-terminal__dot"></span>
                  <span class="hero-terminal__label" data-hero-status>deployed</span>
                </span>
              </span>
              <span class="r3-word">
                <span class="r3-r">r</span>
                <span class="r3-badge">3</span>
                <span class="r3-rest">webdesign</span>
              </span>
            </h1>
          </div>
          <p class="p-tech-hero__value">
            Individuelles Webdesign aus Magdeburg — klar gestaltet, schnell geladen und ohne Baukasten.
          </p>
          <p class="p-tech-hero__audience">
            Für Vereine, Events, lokale Unternehmen und digitale Produkte.
          </p>
          <div class="p-tech-hero__actions">
            <a href="/kontakt/" class="p-tech-hero__cta p-tech-hero__cta--primary">Projekt anfragen</a>
            <a href="#projekte" class="p-tech-hero__cta p-tech-hero__cta--secondary">Referenzen ansehen</a>
          </div>
        </div>

        <StyleShowcase />
      </div>
    </header>

    <TechSeam />

    <section class="tech-manifesto" id="technik" aria-labelledby="tech-manifesto-title">
      <div class="container tech-manifesto__inner autoShow">
        <div class="tech-manifesto__head">
          <p>&gt; r³/prinzipien</p>
          <h2 id="tech-manifesto-title">So arbeite ich.</h2>
        </div>
        <ol class="tech-manifesto__rail">
          <li><span>01</span><strong>Erst verstehen.<br />Dann gestalten.</strong></li>
          <li><span>02</span><strong>Schnell ist keine<br />Zusatzoption.</strong></li>
          <li><span>03</span><strong>Direkter Draht statt<br />Agentur-Pingpong.</strong></li>
        </ol>
        <p class="tech-manifesto__stamp">gebaut in Magdeburg · für echte Menschen</p>
      </div>
    </section>

  </div>

  <CandyTapeDivider />

  <!-- ═══ 02 SIGNATURE ═══ -->
  <div class="p-zone p-zone--candy" id="candy">
    <div class="p-zone__inner p-zone__inner--header">
      <ZoneHeader
        variant="candy"
        num={BIOME_META.candy.num}
        label={BIOME_META.candy.label}
        title={BIOME_META.candy.title}
        description={BIOME_META.candy.description}
      />
    </div>

    <div class="candy-marquee" aria-hidden="true">
      <div class="candy-marquee__track">
        {[...candyMarqueeWords, ...candyMarqueeWords].map((word) => (
          <span class="candy-marquee__word">{word}</span>
        ))}
      </div>
    </div>

    <section class="candy-about" id="about" aria-labelledby="candy-about-title">
      <div class="container">
        <div class="candy-about__inner">
          <figure class="candy-about__portrait autoShow">
            <div class="candy-about__avatar">
              <div class="candy-about__frame" aria-hidden="true"></div>
              <div class="candy-about__photo">
                <img
                  src="/images/responsive/IMG_1907-480.webp"
                  srcset="/images/responsive/IMG_1907-480.webp 480w, /images/responsive/IMG_1907-800.webp 800w"
                  sizes="(max-width: 899px) min(78vw, 320px), 320px"
                  alt="Dustin Rose – Webentwickler in Magdeburg"
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <span class="candy-about__duotone" aria-hidden="true"></span>
                <span class="candy-about__shine" aria-hidden="true"></span>
              </div>
            </div>
            <figcaption class="candy-about__caption">Dustin · Magdeburg</figcaption>
          </figure>

          <article class="candy-about__card autoShow">
            <p class="candy-about__tag">Über mich</p>
            <h3 class="candy-about__title" id="candy-about-title">
              Hi, ich bin <span class="candy-about__name">Dustin</span>.
            </h3>
            <p class="candy-about__role">Webentwickler &amp; UI/UX Designer</p>
            <div class="candy-about__text">
              <p>Ich verbinde Gestaltung, sauberen Code und Performance — ohne Baukasten und ohne unnötige Umwege.</p>
              <p>Von der ersten Idee bis zum Launch bekommst du einen direkten Ansprechpartner und nachvollziehbare Entscheidungen.</p>
            </div>
            <ul class="candy-about__bubbles" aria-label="Schwerpunkte">
              <li>Performance</li>
              <li>Barrierefrei</li>
              <li>Design + Code</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
  </div>

  <ZoneCut variant="drop" fill="#0d0616" accent="#10b981" front="#f8fafc" />

  <!-- ═══ 03 CLEAN ═══ -->
  <div class="p-zone p-zone--clean">
    <div class="p-zone__inner p-zone__inner--header">
      <ZoneHeader
        variant="clean"
        num={BIOME_META.clean.num}
        label={BIOME_META.clean.label}
        title={BIOME_META.clean.title}
        description={BIOME_META.clean.description}
      />
    </div>

    <section id="projekte" class="section projects projects--clean">
      <div class="clean-block-head autoShow">
        <h3 class="clean-block-head__title">Ausgewählte Referenzen</h3>
        <p class="clean-block-head__lead">
          Drei Projekte — von der Vereinswebsite bis zur Fullstack-Plattform.
        </p>
      </div>
      <div class="card-grid card-grid--clean">
      {featuredProjects.map((project) => (
        <ProjectCard
          variant="clean"
          title={project.data.title}
          description={project.data.subtitle}
          image={project.data.image}
          tags={project.data.techStack}
          id={projectSlug(project)}
        />
      ))}
    </div>
    <p class="projects-more projects-more--clean autoShow">
      <a href="/projekte/" class="projects-more__link">
        Alle Projekte ansehen →
      </a>
    </p>
  </section>

  <section id="leistungen" class="section services services--clean">
    <div class="container">
      <div class="clean-block-head autoShow">
        <p class="clean-block-head__kicker">Was ich umsetze</p>
        <h3 class="clean-block-head__title">Vier Wege zu deinem digitalen Produkt</h3>
        <p class="clean-block-head__lead">
          Vom fokussierten Webauftritt bis zur langfristig betreuten Plattform — passend zum Ziel, nicht zum Trend.
        </p>
      </div>

      <ul class="services-grid">
        <li class="service-card autoShow">
          <header class="service-card__head">
            <p class="service-card__path"><span class="service-card__prompt">&gt;_</span> publish.static</p>
          </header>
          <div class="service-card__body">
            <h4>Webseiten &amp; Landingpages</h4>
            <p class="service-card__text">Individuelles Design, saubere Inhalte, SEO und schnelle Ladezeiten ohne austauschbare Schablone.</p>
          </div>
          <ul class="service-card__chips" aria-label="Schwerpunkte"><li>Astro</li><li>SEO</li><li>Barrierefrei</li></ul>
        </li>

        <li class="service-card autoShow">
          <header class="service-card__head">
            <p class="service-card__path"><span class="service-card__prompt">&gt;_</span> platform.core</p>
          </header>
          <div class="service-card__body">
            <h4>Web-Apps &amp; Dashboards</h4>
            <p class="service-card__text">Login, Datenbank und Admin-Bereiche — Systeme, die mit deinem Arbeitsalltag mitwachsen.</p>
          </div>
          <ul class="service-card__chips" aria-label="Schwerpunkte"><li>Supabase</li><li>SSR</li><li>Auth</li></ul>
        </li>

        <li class="service-card autoShow">
          <header class="service-card__head">
            <p class="service-card__path"><span class="service-card__prompt">&gt;_</span> mobile.app</p>
          </header>
          <div class="service-card__body">
            <h4>Native Apps</h4>
            <p class="service-card__text">Eine belastbare Codebasis für iOS und Android — vom ersten Prototyp bis zum Store-Release.</p>
          </div>
          <ul class="service-card__chips" aria-label="Schwerpunkte"><li>Expo</li><li>iOS</li><li>Android</li></ul>
        </li>

        <li class="service-card autoShow">
          <header class="service-card__head">
            <p class="service-card__path"><span class="service-card__prompt">&gt;_</span> maintain.loop</p>
          </header>
          <div class="service-card__body">
            <h4>Betreuung &amp; Weiterentwicklung</h4>
            <p class="service-card__text">Updates, Performance und neue Funktionen — auch nach dem Launch bleibt der Kontakt direkt.</p>
          </div>
          <ul class="service-card__chips" aria-label="Schwerpunkte"><li>Updates</li><li>Monitoring</li><li>Support</li></ul>
        </li>
      </ul>
    </div>
  </section>

  <section class="project-process" aria-labelledby="process-title">
    <div class="container">
      <div class="clean-block-head autoShow">
        <p class="clean-block-head__kicker">Zusammenarbeit</p>
        <h3 class="clean-block-head__title" id="process-title">In vier klaren Schritten zum Launch</h3>
      </div>
      <ol class="project-process__grid">
        <li class="project-process__step autoShow"><span>01</span><h4>Kennenlernen</h4><p>Ziele, Zielgruppe und Rahmen in einem kurzen Gespräch klären.</p></li>
        <li class="project-process__step autoShow"><span>02</span><h4>Konzept</h4><p>Struktur, Gestaltung und technische Lösung nachvollziehbar festlegen.</p></li>
        <li class="project-process__step autoShow"><span>03</span><h4>Umsetzung</h4><p>Design und Entwicklung mit regelmäßigen, sichtbaren Zwischenständen.</p></li>
        <li class="project-process__step autoShow"><span>04</span><h4>Launch</h4><p>Qualitätsprüfung, Veröffentlichung und eine saubere Übergabe.</p></li>
      </ol>
    </div>
  </section>

  </div>

  <ZoneCut variant="cradle" fill="#141c12" accent="#6b5344" front="#e8e0d4" />

  <!-- ═══ 04 GROUNDED ═══ -->
  <section class="p-zone p-zone--earth" id="abschluss" aria-labelledby="earth-title">
    <div class="p-zone__inner">
      <div>
        <ZoneHeader
          variant="earth"
          num={EARTH_META.num}
          label={EARTH_META.label}
          title={EARTH_META.title}
          description={EARTH_META.description}
          titleId="earth-title"
        />
        <div class="p-earth-panel autoShow">
          <p>Webdesign Magdeburg · remote möglich · kein Baukasten, kein Bullshit.</p>
        </div>
      </div>
    </div>

    <section id="faq" class="faq faq--earth" aria-labelledby="faq-title">
      <div class="container">
        <div class="earth-faq__head autoShow">
          <p>Vor der Anfrage</p>
          <h3 id="faq-title">Häufige Fragen, ehrlich beantwortet</h3>
        </div>
        <div class="faq-grid">
          {faqItems.map((item) => (
            <details class="faq-item autoShow">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <div class="p-earth-actions p-earth-actions--final autoShow">
      <a href="/kontakt/" class="p-earth-btn">Unverbindlich anfragen</a>
      <a href="/projekte/" class="p-earth-btn p-earth-btn--ghost">Alle Referenzen</a>
    </div>
  </section>
</article>
</BaseLayout>

<script>
  (() => {
    const root = document.querySelector('.hero-terminal');
    const label = document.querySelector('[data-hero-status]');
    if (!root || !label) return;

    const sequence = [
      { phase: 'deployed', text: 'deployed', hold: 750 },
      { phase: 'building', text: 'building…', hold: 1100 },
      { phase: 'ready', text: 'ready', hold: 0 },
    ];

    const finish = () => {
      root.classList.remove('is-booting', 'is-fading');
      root.classList.add('is-ready');
      root.dataset.phase = 'ready';
      label.textContent = 'ready';
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      finish();
      return;
    }

    let step = 0;

    const showStep = () => {
      const current = sequence[step];
      root.dataset.phase = current.phase;
      label.textContent = current.text;

      if (current.phase === 'ready') {
        finish();
        return;
      }

      step += 1;
      setTimeout(() => {
        root.classList.add('is-fading');
        setTimeout(() => {
          root.classList.remove('is-fading');
          showStep();
        }, 160);
      }, current.hold);
    };

    showStep();
  })();
</script>

<script>
  (() => {
    const animatedSections = document.querySelectorAll('.candy-marquee');
    if (!animatedSections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-active', entry.isIntersecting);
        });
      },
      { rootMargin: '10% 0px', threshold: 0.05 }
    );

    animatedSections.forEach((element) => observer.observe(element));
  })();
</script>

<style>
  /* =========================================
     1. GLOBALE STRUKTUR & TYPOGRAFIE
     ========================================= */

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem; /* Mobil-Rand garantiert */
  }

  /* Einheitliche Header für ALLE Sektionen — Basis in style.css (.section-head, .section-title) */
  .section-head {
    margin-bottom: 5rem;
  }

  /* =========================================
     LEISTUNGEN
     ========================================= */

  .services {
    background-color: #0b1120;
    padding: clamp(5rem, 10vw, 8rem) 0;
    color: #fff;
  }

  .services .section-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .services-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin-inline: auto;
    align-items: stretch;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 18.5rem;
    align-items: stretch;
    text-align: left;
    padding: clamp(1.25rem, 3vw, 1.6rem);
    padding-top: clamp(1.5rem, 3.5vw, 1.85rem);
    border-radius: 14px;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 42%, transparent 100%),
      rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 12px 32px rgba(0, 0, 0, 0.28);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    background: linear-gradient(
      165deg,
      rgba(16, 185, 129, 0.22) 0%,
      transparent 38%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  /* Bunte Top-Kante: Grün → ausblendend nach rechts (wie Tech-Stack-Karten) */
  .service-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #10b981 0%, #38bdf8 55%, transparent 100%);
    opacity: 0.65;
    pointer-events: none;
    z-index: 3;
    box-shadow: 0 0 18px rgba(16, 185, 129, 0.28);
    transition: opacity 0.4s ease, box-shadow 0.4s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(16, 185, 129, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 48px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(16, 185, 129, 0.08);
  }

  .service-card:hover::before {
    opacity: 0.72;
  }

  .service-card:hover::after {
    opacity: 0.85;
    box-shadow: 0 0 22px rgba(16, 185, 129, 0.38);
  }

  .service-card__head,
  .service-card__body,
  .service-card__chips {
    position: relative;
    z-index: 2;
  }

  .service-card__head {
    width: 100%;
    flex-shrink: 0;
    margin-bottom: 0.85rem;
    padding-bottom: 0.65rem;
  }

  .service-card__head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    right: calc(0.5rem + clamp(3.2rem, 9vw, 4.2rem) + 0.65rem);
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .service-card__path {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    min-height: 1.15rem;
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #64748b;
    text-transform: lowercase;
  }

  .service-card__prompt {
    color: #10b981;
    font-weight: 700;
  }

  .service-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .service-card :is(h3, h4) {
    position: relative;
    z-index: 1;
    margin: 0 0 0.6rem;
    padding-right: 2rem;
    min-height: 2.75em;
    font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    font-weight: 800;
    line-height: 1.25;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .service-card__text {
    position: relative;
    z-index: 1;
    flex: 1;
    margin: 0;
    font-size: clamp(0.88rem, 1.7vw, 0.96rem);
    line-height: 1.62;
    color: #94a3b8;
  }

  .service-card__chips {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.35rem;
    width: 100%;
    min-height: 1.85rem;
    margin: 0.85rem 0 0;
    padding-top: 0.75rem;
    padding-left: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    list-style: none;
  }

  .service-card__chips li {
    flex: 1 1 0;
    min-width: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: #cbd5e1;
    padding: 0.32rem 0.25rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .services-cta {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    text-align: center;
  }

  .services-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: #ecfdf5;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 28px rgba(16, 185, 129, 0.15);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .services-cta__prompt {
    font-family: ui-monospace, monospace;
    color: #10b981;
    font-weight: 700;
  }

  .services-cta__btn:hover {
    transform: translateY(-2px);
    background: rgba(16, 185, 129, 0.2);
    border-color: #34d399;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      0 14px 36px rgba(16, 185, 129, 0.28);
  }

  .services-cta__btn:active {
    transform: translateY(0);
  }

  @media (min-width: 600px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.15rem;
    }

    .service-card {
      min-height: 19.5rem;
    }
  }

  @media (max-width: 599px) {
    .service-card {
      min-height: 0;
    }

    .service-card :is(h3, h4) {
