    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #10b981 0%, #38bdf8 55%, transparent 100%);
    opacity: 0.65;
    pointer-events: none;
  }

  .faq:not(.faq--clean) .faq-item:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 185, 129, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 16px 30px rgba(0, 0, 0, 0.28);
  }

  .faq:not(.faq--clean) .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-height: calc(2.1rem + 2.7em);
    padding: 1.1rem 2.9rem 1rem 1.1rem;
    font-weight: 700;
    color: #f3f4f6;
    line-height: 1.35;
    position: relative;
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-height: calc(2.1rem + 2.7em);
    padding: 1.1rem 2.9rem 1rem 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    position: relative;
  }

  .faq--clean .faq-item summary {
