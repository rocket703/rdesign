     FAQ SEKTION
     ========================================= */

  .faq:not(.faq--clean) {
    background-color: #0b1120;
    padding: 3.5rem 0 8rem;
  }

  .faq:not(.faq--clean) .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
