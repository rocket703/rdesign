---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects, projectSlug } from '../lib/projects';
import { faqItems } from '../data/faq';
import ZoneCut from '../components/ZoneCut.astro';
import { cutFillPath, CUT_VIEWBOX } from '../lib/zone-cut-paths';
import ZoneHeader from '../components/ZoneHeader.astro';
import ZoneWatermark from '../components/ZoneWatermark.astro';
import TechSeam from '../components/TechSeam.astro';
import StyleShowcase from '../components/StyleShowcase.astro';
import OfferIcon from '../components/OfferIcon.astro';
import OfferVisual from '../components/OfferVisual.astro';
import { packages, offerPath } from '../data/offers';
import { services } from '../data/services';
import { responsiveImage } from '../lib/images';
import CandyTapeDivider from '../components/CandyTapeDivider.astro';
import GroundTapeDivider from '../components/GroundTapeDivider.astro';
import { BIOME_META, EARTH_META } from '../data/portfolio-biomes';
import '../styles/home-world.css';

import { homePageSchema, SITE } from '../lib/seo';

const candyMarqueeWords = [
  'Webdesign Magdeburg',
  'Events',
  'Vereine',
  'Bands',
  'Unternehmen',
  'Individuell',
  'Persönlich',
  'Performance',
  'Mit Charakter',
  'Direkt',
] as const;

// Hügel-Silhouette als Maske für die Earth-Zone: deren eigener Hintergrund
// füllt den Hügel, darüber scheint die Clean-Zone durch – ohne Nahtkante.
const earthMaskSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='${CUT_VIEWBOX}' preserveAspectRatio='none'><path d='${cutFillPath('cradle')}'/></svg>`;
const earthMask = `url("data:image/svg+xml,${encodeURIComponent(earthMaskSvg)}")`;

const steps = [
  {
    title: 'Kennenlernen & Konzept',
    text: 'Erst verstehen, dann gestalten: Im Erstgespräch klären wir Ziele, Zielgruppe und Inhalte. Danach bekommst du ein klares Konzept und ein transparentes Festpreisangebot.',
    check: 'Kostenlos & unverbindlich',
  },
  {
    title: 'Design & Umsetzung',
    text: 'Du siehst regelmäßig sichtbare Zwischenstände und sprichst immer direkt mit der Person, die deine Seite baut – ohne Ticketsysteme und Umwege.',
    check: 'Antwort meist innerhalb von 24 h',
  },
  {
    title: 'Launch & Betreuung',
    text: 'Nach der Qualitätsprüfung geht deine Seite live – schnell geladen, auch mobil. Danach bleibe ich für Updates und neue Funktionen ansprechbar.',
    check: 'Performance von Anfang an',
  },
] as const;

const portrait = responsiveImage(SITE.portrait, 320);

const publishedProjects = await getPublishedProjects();

const featuredSlugs = ['startplatzboerse', 'ohrelauf', 'radsportclub-magdeburg'];
const featuredProjects = featuredSlugs
  .map((slug) => publishedProjects.find((project) => projectSlug(project) === slug))
  .filter((project): project is (typeof publishedProjects)[number] => Boolean(project));

---

<BaseLayout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  jsonLd={homePageSchema(faqItems, Astro.site)}
>
<article class="p-world home-world">
  <!-- ═══ 01 TECHNICAL ═══ -->
  <div class="p-zone p-zone--tech">
    <header class="p-tech-hero" id="intro">
      <div class="hero-ambient" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-spotlight"></div>
      </div>

      <div class="p-tech-hero__inner">
        <div class="p-tech-hero__brand intro">
          <div class="section-head hero-brand">
            <div class="r3-logo">
              <span class="r3-word">
                <span class="r3-r">r</span>
                <span class="r3-badge">3</span>
                <span class="r3-rest">webdesign</span>
              </span>
              <h1 class="r3-logo__claim">Webdesign &amp; Webentwicklung in Magdeburg</h1>
            </div>
          </div>
          <p class="p-tech-hero__value">
            Klar gestaltet, schnell geladen und ohne Baukasten – für Vereine, Events und lokale Unternehmen.
          </p>
          <div class="p-tech-hero__actions">
            <a href="/kontakt/" class="p-tech-hero__cta p-tech-hero__cta--primary">Projekt anfragen</a>
            <a href="#projekte" class="p-tech-hero__cta p-tech-hero__cta--secondary">Projekte ansehen</a>
          </div>
        </div>

      </div>
    </header>

    <TechSeam />

    <section class="tech-manifesto" id="technik" aria-labelledby="tech-manifesto-title">
      <div class="container tech-manifesto__inner">
        <header class="tech-manifesto__head zone-h zone-h--bar autoShow">
          <ZoneWatermark num="01" />
          <span class="tech-manifesto__kicker">Ablauf</span>
          <p class="zone-h__title">Schritt für Schritt</p>
          <h2 class="zone-h__desc" id="tech-manifesto-title">
            So läuft ein Webdesign-Projekt ab: drei klare Schritte vom ersten Gespräch bis nach dem Launch.
          </h2>
        </header>
        <ol class="tech-manifesto__pipeline">
          {steps.map((step, index) => (
            <li class="tech-manifesto__step autoShow">
              <span class="tech-manifesto__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="tech-manifesto__body">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <p class="tech-manifesto__check"><span aria-hidden="true">✓</span> {step.check}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

  </div>

  <CandyTapeDivider />

  <!-- ═══ 02 SIGNATURE ═══ -->
  <div class="p-zone p-zone--candy" id="candy">
    <div class="p-zone__inner p-zone__inner--header">
      <ZoneHeader
        variant="candy"
        num={BIOME_META.candy.num}
        label={BIOME_META.candy.label}
        title={BIOME_META.candy.title}
        description={BIOME_META.candy.description}
      />
    </div>

    <div class="candy-marquee" aria-hidden="true">
      <div class="candy-marquee__track">
        {[...candyMarqueeWords, ...candyMarqueeWords].map((word, index) => (
          <span class:list={['candy-marquee__word', { 'candy-marquee__word--clone': index >= candyMarqueeWords.length }]}>{word}</span>
        ))}
      </div>
    </div>

    <section class="candy-about" id="about" aria-labelledby="candy-about-title">
      <div class="container">
        <div class="candy-about__inner">
          <figure class="candy-about__portrait autoShow">
            <div class="candy-about__avatar">
              <div class="candy-about__frame" aria-hidden="true"></div>
              <div class="candy-about__photo">
                <img
                  src={portrait.src}
                  srcset={portrait.srcset}
                  sizes="(max-width: 899px) min(78vw, 320px), 320px"
                  alt="Dustin Rose – Webentwickler in Magdeburg"
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <span class="candy-about__duotone" aria-hidden="true"></span>
                <span class="candy-about__shine" aria-hidden="true"></span>
              </div>
            </div>
            <figcaption class="candy-about__caption">Dustin · Magdeburg</figcaption>
          </figure>

          <article class="candy-about__card autoShow">
            <h2 class="candy-about__title" id="candy-about-title">
              Hi, ich bin <span class="candy-about__name">Dustin</span>.
            </h2>
            <p class="candy-about__role">Webentwickler &amp; Webdesigner</p>
            <div class="candy-about__text">
              <p>Ich verbinde Gestaltung, Technik und schnelle Ladezeiten – ohne Baukasten und ohne unnötige Umwege.</p>
              <p>Von der ersten Idee bis zum Launch bekommst du einen direkten Ansprechpartner und nachvollziehbare Entscheidungen.</p>
            </div>
            <ul class="candy-about__bubbles" aria-label="Schwerpunkte">
              <li>Performance</li>
              <li>Barrierefrei</li>
              <li>Alles aus einer Hand</li>
            </ul>
            <a href="/ueber-mich/" class="candy-about__more">Mehr über mich →</a>
          </article>
        </div>
      </div>
    </section>

    <StyleShowcase />
  </div>

  <ZoneCut variant="drop" fill="#0d0616" accent="#10b981" front="#faf9f6" />

  <!-- ═══ 03 CLEAN ═══ -->
  <div class="p-zone p-zone--clean">
    <div class="p-zone__inner p-zone__inner--header">
      <ZoneHeader
        variant="clean"
        num={BIOME_META.clean.num}
        label={BIOME_META.clean.label}
        title={BIOME_META.clean.title}
        description={BIOME_META.clean.description}
      />
    </div>

    <section id="projekte" class="section projects projects--clean">
      <div class="clean-block-head autoShow">
        <h2 class="clean-block-head__title">Referenzen aus Magdeburg &amp; Umgebung</h2>
        <p class="clean-block-head__lead">
          Drei Projekte – von der Vereins-Webseite bis zur Online-Plattform.
        </p>
      </div>
      <div class="card-grid card-grid--clean">
      {featuredProjects.map((project) => (
        <ProjectCard
          variant="clean"
          title={project.data.title}
          description={project.data.subtitle}
          image={project.data.image}
          tags={project.data.techStack}
          id={projectSlug(project)}
        />
      ))}
    </div>
    <p class="projects-more projects-more--clean autoShow">
      <a href="/projekte/" class="projects-more__link">
        Alle Projekte ansehen →
      </a>
    </p>
  </section>

  <section id="leistungen" class="section services services--clean">
    <div class="container">
      <div class="clean-block-head autoShow">
        <p class="clean-block-head__kicker">Leistungen</p>
        <h2 class="clean-block-head__title">Webdesign, Web-Apps &amp; Apps</h2>
        <p class="clean-block-head__lead">
          Vom fokussierten Webauftritt bis zur langfristig betreuten Plattform – passend zum Ziel, nicht zum Trend.
        </p>
      </div>

      <ul class="services-grid">
        {services.map((service) => (
          <li class="service-card autoShow">
            <div class="service-card__body">
              <h3>{service.title}</h3>
              <p class="service-card__text">{service.text}</p>
            </div>
            <ul class="service-card__chips" aria-label="Schwerpunkte">
              {service.chips.map((chip) => <li>{chip}</li>)}
            </ul>
            {service.href && (
              <a class="service-card__link" href={service.href}>Mehr erfahren <span aria-hidden="true">→</span></a>
            )}
          </li>
        ))}
      </ul>
      <p class="projects-more projects-more--clean autoShow">
        <a href="/leistungen/" class="projects-more__link">Alle Leistungen im Überblick →</a>
      </p>
    </div>
  </section>

  <section class="quickstart" aria-labelledby="quickstart-title">
    <div class="container">
      <div class="clean-block-head autoShow">
        <p class="clean-block-head__kicker">Schnellstart</p>
        <h2 class="clean-block-head__title" id="quickstart-title">Du hast schon eine Webseite?</h2>
        <p class="clean-block-head__lead">
          Drei feste Pakete für bestehende Seiten – mit klarem Ergebnis und Festpreis.
        </p>
      </div>
      <ul class="quickstart__grid">
        {packages.map((offer) => (
          <li class="autoShow">
            <a href={offerPath(offer)} class="quickstart-card">
              <OfferVisual name={offer.icon} />
              <div class="quickstart-card__head">
                <span class="quickstart-card__icon">
                  <OfferIcon name={offer.icon} size={22} />
                </span>
                <h3 class="quickstart-card__title">{offer.title}</h3>
              </div>
              <p class="quickstart-card__text">{offer.teaser}</p>
              <div class="quickstart-card__foot">
                <span class="quickstart-card__meta">{offer.facts.find((fact) => fact.label === 'Dauer')?.value}</span>
                <span class="quickstart-card__more">Mehr erfahren <span class="quickstart-card__arrow" aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  </div>

  <!-- ═══ 04 GROUNDED ═══ -->
  <section class="p-zone p-zone--earth" id="abschluss" aria-labelledby="earth-title" style={`--earth-mask: ${earthMask}`}>
    <div class="p-zone__inner">
      <div>
        <ZoneHeader
          variant="earth"
          num={EARTH_META.num}
          label={EARTH_META.label}
          title={EARTH_META.title}
          description={EARTH_META.description}
          titleId="earth-title"
        />
        <div class="p-earth-panel autoShow">
          <p>Webdesign aus Magdeburg · remote möglich · individuell und direkt.</p>
        </div>
      </div>
    </div>

    <section id="faq" class="faq faq--earth" aria-labelledby="faq-title">
      <div class="container">
        <div class="earth-faq__head autoShow">
          <h2 id="faq-title">Häufige Fragen zum Webdesign</h2>
        </div>
        <div class="faq-grid">
          {faqItems.map((item) => (
            <details class="faq-item autoShow">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <div class="p-earth-actions p-earth-actions--final autoShow">
      <a href="/kontakt/" class="p-earth-btn">Projekt anfragen</a>
      <a href="/projekte/" class="p-earth-btn p-earth-btn--ghost">Alle Projekte ansehen</a>
    </div>
  </section>

  <GroundTapeDivider />
</article>
</BaseLayout>

<script>
  (() => {
    const animatedSections = document.querySelectorAll('.candy-marquee');
    if (!animatedSections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-active', entry.isIntersecting);
        });
      },
      { rootMargin: '10% 0px', threshold: 0.05 }
    );

    animatedSections.forEach((element) => observer.observe(element));
  })();
</script>

<style>
  /* =========================================
     1. GLOBALE STRUKTUR & TYPOGRAFIE
     ========================================= */

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem; /* Mobil-Rand garantiert */
  }

  /* Einheitliche Header für ALLE Sektionen — Basis in style.css (.section-head, .section-title) */
  .section-head {
    margin-bottom: 5rem;
  }

  /* =========================================
     LEISTUNGEN
     ========================================= */

  .services {
    background-color: #0b1120;
    padding: clamp(5rem, 10vw, 8rem) 0;
    color: #fff;
  }

  .services .section-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .services-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin-inline: auto;
    align-items: stretch;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 18.5rem;
    align-items: stretch;
    text-align: left;
    padding: clamp(1.25rem, 3vw, 1.6rem);
    padding-top: clamp(1.5rem, 3.5vw, 1.85rem);
    border-radius: 14px;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 42%, transparent 100%),
      rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 12px 32px rgba(0, 0, 0, 0.28);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    background: linear-gradient(
      165deg,
      rgba(16, 185, 129, 0.22) 0%,
      transparent 38%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  /* Bunte Top-Kante: Grün → ausblendend nach rechts (wie Tech-Stack-Karten) */
  .service-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #10b981 0%, #38bdf8 55%, transparent 100%);
    opacity: 0.65;
    pointer-events: none;
    z-index: 3;
    box-shadow: 0 0 18px rgba(16, 185, 129, 0.28);
    transition: opacity 0.4s ease, box-shadow 0.4s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(16, 185, 129, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 48px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(16, 185, 129, 0.08);
  }

  .service-card:hover::before {
    opacity: 0.72;
  }

  .service-card:hover::after {
    opacity: 0.85;
    box-shadow: 0 0 22px rgba(16, 185, 129, 0.38);
  }

  .service-card__head,
  .service-card__body,
  .service-card__link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--r3-green-ink);
  }

  .service-card__link:hover {
    text-decoration: underline;
  }

  .service-card__chips {
    position: relative;
    z-index: 2;
  }

  .service-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .service-card :is(h3, h4) {
    position: relative;
    z-index: 1;
    margin: 0 0 0.6rem;
    padding-right: 2rem;
    min-height: 2.75em;
    font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    font-weight: 800;
    line-height: 1.25;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .service-card__text {
    position: relative;
    z-index: 1;
    flex: 1;
    margin: 0;
    font-size: clamp(0.88rem, 1.7vw, 0.96rem);
    line-height: 1.62;
    color: #94a3b8;
  }

  .service-card__chips {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    width: 100%;
    min-height: 1.85rem;
    margin: 0.85rem 0 0;
    padding-top: 0.75rem;
    padding-left: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    list-style: none;
  }

  .service-card__chips li {
    flex: 1 1 auto;
    min-width: 0;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: #cbd5e1;
    padding: 0.32rem 0.25rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .services-cta {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    text-align: center;
  }

  .services-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: #ecfdf5;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 28px rgba(16, 185, 129, 0.15);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .services-cta__prompt {
    font-family: inherit;
    color: #10b981;
    font-weight: 700;
  }

  .services-cta__btn:hover {
    transform: translateY(-2px);
    background: rgba(16, 185, 129, 0.2);
    border-color: #34d399;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      0 14px 36px rgba(16, 185, 129, 0.28);
  }

  .services-cta__btn:active {
    transform: translateY(0);
  }

  @media (min-width: 600px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.15rem;
    }

    .service-card {
      min-height: 19.5rem;
    }
  }

  @media (max-width: 599px) {
    .service-card {
      min-height: 0;
    }

    .service-card :is(h3, h4) {
      min-height: 0;
    }

    .service-card__chips {
      flex-wrap: wrap;
    }

    .service-card__chips li {
      flex: 0 1 auto;
      min-width: auto;
    }
  }

  .services-grid .autoShow:nth-child(1) { transition-delay: 0.05s; }
  .services-grid .autoShow:nth-child(2) { transition-delay: 0.12s; }
  .services-grid .autoShow:nth-child(3) { transition-delay: 0.19s; }
  .services-grid .autoShow:nth-child(4) { transition-delay: 0.26s; }

  /* =========================================
     2. DEV SHOWCASE SEKTION (Tech Stack)
     ========================================= */

  .dev-showcase {
    background: #0b1120;
    padding: clamp(5rem, 10vw, 8rem) 0;
    color: #fff;
  }

  /* --- GRID LAYOUT --- */
  .skill-grid {
    display: grid;
    grid-template-columns: 1fr; /* Mobil: Alles untereinander */
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* DESKTOP LAYOUT: 3 kleine Karten links, Code rechts */
  @media (min-width: 1024px) {
    .skill-grid {
      grid-template-columns: 1fr 1.5fr; 
      grid-template-rows: auto auto auto; 
      gap: 2rem;
      padding: 0;
    }

    /* Links: Die 3 kleinen Karten stapeln sich */
    .primary {
      grid-column: 1 / 2;
      grid-row: 1 / 2;
    }

    .secondary {
      grid-column: 1 / 2;
      grid-row: 2 / 3;
    }

    .dynamic-cube {
      grid-column: 1 / 2;
      grid-row: 3 / 4;
    }

    /* Rechts: Das Code-Fenster über die volle Höhe */
    .code-window {
      grid-column: 2 / 3;
      grid-row: 1 / 4;
      height: 100%;
    }
  }

