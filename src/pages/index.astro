  /* Blur-Animation nicht auf rundes Bild (Mobile-Bug) */
  .about__avatar-shell.autoShow {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.85s cubic-bezier(0.22, 0.61, 0.36, 1),
