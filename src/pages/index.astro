  .services-grid .autoShow:nth-child(1) { transition-delay: 0.05s; }
  .services-grid .autoShow:nth-child(2) { transition-delay: 0.12s; }
  .services-grid .autoShow:nth-child(3) { transition-delay: 0.19s; }
  .services-grid .autoShow:nth-child(4) { transition-delay: 0.26s; }

  /* =========================================
     2. DEV SHOWCASE SEKTION (Tech Stack)
     ========================================= */

  .dev-showcase {
    background: #0b1120;
    padding: clamp(5rem, 10vw, 8rem) 0;
    color: #fff;
  }

  /* --- GRID LAYOUT --- */
  .skill-grid {
    display: grid;
    grid-template-columns: 1fr; /* Mobil: Alles untereinander */
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* DESKTOP LAYOUT: 3 kleine Karten links, Code rechts */
  @media (min-width: 1024px) {
    .skill-grid {
      grid-template-columns: 1fr 1.5fr; 
      grid-template-rows: auto auto auto; 
      gap: 2rem;
      padding: 0;
    }

    /* Links: Die 3 kleinen Karten stapeln sich */
    .primary {
      grid-column: 1 / 2;
      grid-row: 1 / 2;
    }

    .secondary {
      grid-column: 1 / 2;
      grid-row: 2 / 3;
    }

    .dynamic-cube {
      grid-column: 1 / 2;
      grid-row: 3 / 4;
    }

    /* Rechts: Das Code-Fenster über die volle Höhe */
    .code-window {
      grid-column: 2 / 3;
      grid-row: 1 / 4;
      height: 100%;
    }
  }

  /* KARTEN DESIGN */
  .skill-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .skill-card:hover {
    transform: translateY(-5px);
    border-color: #10b981;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .skill-card.primary,
  .skill-card.secondary {
    align-items: flex-start;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
  }

  .skill-card.primary::before,
  .skill-card.secondary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #10b981 0%, #38bdf8 55%, transparent 100%);
    opacity: 0.65;
    pointer-events: none;
  }

  .skill-card__path {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.85rem;
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #64748b;
    text-transform: lowercase;
  }

  .skill-card__prompt {
    color: #10b981;
    font-weight: 700;
  }

  .skill-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.15rem 0 0;
    padding: 0;
    width: 100%;
  }

  .skill-card__stats li {
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #cbd5e1;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .skill-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: #fff;
  }

  .skill-card p {
    color: #94a3b8;
    line-height: 1.6;
  }

  /* CODE WINDOW */
  .code-window {
    background: #011627 !important;
    padding: 0 !important;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    display: flex;
    flex-direction: column;
  }

  .window-header {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(0, 0, 0, 0.5);
  }

  .dot-group { 
    display: flex; 
    gap: 8px; 
  }

  .dot { 
    width: 12px; 
    height: 12px; 
    border-radius: 50%; 
  }

  .red { background: #ff5f56; } 
  .yellow { background: #ffbd2e; } 
  .green { background: #27c93f; }

  .filename { 
    font-size: 0.8rem; 
    color: #607b96; 
    font-family: 'Fira Code', monospace; 
  }

  .code-area {
    padding: 2rem;
    font-family: 'Fira Code', ui-monospace, monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    overflow-x: auto;
    flex-grow: 1;
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.04) 0%, transparent 35%);
  }

  .code-area pre {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .code-area code {
    color: #d6deeb;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .code-area :global(.tok-cm) { color: #5c7e9e; font-style: italic; }
  .code-area :global(.tok-str) { color: #ecc48d; }
  .code-area :global(.tok-kw) { color: #c792ea; }
  .code-area :global(.tok-type) { color: #82aaff; }
  .code-area :global(.tok-fn) { color: #7fdbca; }

  .code-cursor {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.65);
    margin-left: 2px;
    flex-shrink: 0;
    animation: codeCursorBlink 1s step-end infinite;
  }

  .code-area.is-typing-done .code-cursor {
    display: none;
  }

  @keyframes codeCursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (max-width: 768px) {
    .dev-showcase {
      padding: clamp(4rem, 12vw, 5rem) 0;
    }

    .skill-grid {
      gap: 1.25rem;
      padding: 0 1rem;
    }

    .skill-card {
      padding: 1.35rem 1.25rem;
    }

    .skill-card h3 {
      font-size: 1.35rem;
      margin-bottom: 0.65rem;
    }

    .skill-card p {
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .skill-card__path {
      margin-bottom: 0.55rem;
      font-size: 0.68rem;
    }

    .skill-card__stats {
      margin-top: 0.85rem;
    }

    .dynamic-cube {
      min-height: 0;
      padding: 1.35rem 1.25rem;
      gap: 0.75rem;
    }

    .cube-scene {
      min-height: 8.5rem;
    }
  }

  /* --- MOBILE ANPASSUNG FÜR DAS CODE-FENSTER --- */
@media (max-width: 768px) {
  .code-window {
    width: 100%;
    max-width: 100vw; /* Zwingt das Fenster, strikt im Bildschirm zu bleiben */
    box-sizing: border-box;
    margin: 0 auto; /* Zentriert es sauber */
  }

  .window-header {
    padding: 0.75rem 1rem; /* Etwas kompakter, spart wertvollen Platz */
  }

  .dot {
    /* [PUNKTE_KLEINER] */
    width: 10px; 
    height: 10px;
  }

  .filename {
    font-size: 0.7rem; /* Dateiname dezent verkleinert */
  }

  .code-area {
    padding: 1rem; /* Padding halbiert: Gibt dem Code 2rem mehr Platz zum Atmen */
    font-size: 0.75rem; /* Die Schrift "ein müh" kleiner */
  }
}

  /* --- TECH STACK WÜRFEL --- */
  .dynamic-cube {
    --cube-size: 5.5rem;
    --cube-half: calc(var(--cube-size) / 2);
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 1.25rem;
    perspective: 1100px;
    overflow: hidden;
    cursor: default;
    position: relative;
    isolation: isolate;
  }

  .dynamic-cube::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 15px 15px 0 0;
    background: linear-gradient(90deg, #10b981 0%, #38bdf8 55%, transparent 100%);
    opacity: 0.65;
    pointer-events: none;
    z-index: 3;
  }

  .dynamic-cube .skill-card__path {
    margin-bottom: 0;
    position: relative;
    z-index: 2;
  }

  .cube-scene {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 11rem;
    margin-top: 0.25rem;
  }

  .cube-scene__aura {
    position: absolute;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(16, 185, 129, 0.22) 0%,
      rgba(56, 189, 248, 0.08) 42%,
      transparent 72%
    );
    pointer-events: none;
  }

  .cube-scene__orbit {
    position: absolute;
    width: 9.5rem;
    height: 9.5rem;
    border-radius: 50%;
    border: 1px dashed rgba(16, 185, 129, 0.28);
    pointer-events: none;
  }

  .cube-scene__orbit::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.75);
    transform: translate(-50%, -50%);
  }

  .cube-scene__orbit--inner {
    width: 7.25rem;
    height: 7.25rem;
    border-style: solid;
    border-color: rgba(56, 189, 248, 0.14);
    animation-direction: reverse;
    animation-duration: 14s;
    opacity: 0.85;
  }

  .cube-scene__orbit--inner::after {
    top: auto;
    bottom: 0;
    background: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.65);
    width: 5px;
    height: 5px;
    transform: translate(-50%, 50%);
  }

  .cube-wrapper {
    width: var(--cube-size);
    height: var(--cube-size);
    transform-style: preserve-3d;
    animation: cubeTumbleY 12s linear infinite;
    animation-play-state: paused;
  }

  .cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(-14deg);
  }

  .face {
    position: absolute;
    width: var(--cube-size);
    height: var(--cube-size);
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0;
    border: 1px solid rgba(16, 185, 129, 0.5);
    background: rgba(8, 15, 28, 0.92);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .face span {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f8fafc;
    text-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
    padding: 0 0.15rem;
  }

  .face--front {
    background: linear-gradient(145deg, rgba(16, 185, 129, 0.35), rgba(16, 185, 129, 0.08));
    border-color: rgba(52, 211, 153, 0.55);
    transform: translateZ(var(--cube-half));
  }

  .face--back {
    background: linear-gradient(145deg, rgba(139, 92, 246, 0.32), rgba(139, 92, 246, 0.06));
    border-color: rgba(167, 139, 250, 0.45);
    transform: rotateY(180deg) translateZ(var(--cube-half));
  }

  .face--back span { text-shadow: 0 0 16px rgba(167, 139, 250, 0.45); }

  .face--right {
    background: linear-gradient(145deg, rgba(56, 189, 248, 0.28), rgba(56, 189, 248, 0.06));
    border-color: rgba(56, 189, 248, 0.45);
    transform: rotateY(90deg) translateZ(var(--cube-half));
  }

  .face--right span { text-shadow: 0 0 16px rgba(56, 189, 248, 0.45); }

  .face--left {
    background: linear-gradient(145deg, rgba(251, 191, 36, 0.22), rgba(251, 191, 36, 0.05));
    border-color: rgba(251, 191, 36, 0.4);
    transform: rotateY(-90deg) translateZ(var(--cube-half));
  }

  .face--left span { text-shadow: 0 0 14px rgba(251, 191, 36, 0.35); }

  .face--top {
    background: linear-gradient(145deg, rgba(52, 211, 153, 0.25), rgba(16, 185, 129, 0.06));
    border-color: rgba(52, 211, 153, 0.4);
    transform: rotateX(90deg) translateZ(var(--cube-half));
  }

  .face--bottom {
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.28), rgba(99, 102, 241, 0.06));
    border-color: rgba(129, 140, 248, 0.45);
    transform: rotateX(-90deg) translateZ(var(--cube-half));
  }

  .face--bottom span { text-shadow: 0 0 14px rgba(129, 140, 248, 0.4); }

  @keyframes cubeTumbleY {
    from { transform: rotateY(0deg); }
    to { transform: rotateY(360deg); }
  }

  .dynamic-cube.is-active .cube-wrapper {
    animation-play-state: running;
  }

  @media (max-width: 768px) {
    .dynamic-cube {
      --cube-size: 4.75rem;
    }

    .cube-scene {
      min-height: 9.5rem;
    }

    .cube-scene__aura {
      width: 9rem;
      height: 9rem;
    }

    .cube-scene__orbit {
      width: 8rem;
      height: 8rem;
    }

    .cube-scene__orbit--inner {
      width: 6.25rem;
      height: 6.25rem;
    }

    .cube-wrapper {
      animation: none;
      transform: rotateY(-28deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cube-wrapper,
    .cube,
    .cube-scene__orbit,
    .cube-scene__aura {
      animation: none !important;
    }

    .cube-wrapper {
      transform: rotateY(24deg);
    }

    .cube {
      transform: rotateX(-16deg);
    }
  }

  /* =========================================
     3. PROJEKTE SEKTION
     ========================================= */

  .projects {
