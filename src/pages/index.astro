---
// src/pages/index.astro
// Startseite als Erzählung „Skizze → fertige Seite“: oben gezeichnet (Hero, Ablauf, Leistungen –
// Idee und Planung), nach dem Übergang clean (Referenzen, Über mich, FAQ – das Ergebnis).
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects, projectSlug } from '../lib/projects';
import { faqItems } from '../data/faq';
import StyleShowcase from '../components/StyleShowcase.astro';
import { services, moreServices, serviceIcons } from '../data/services';
import { responsiveImage } from '../lib/images';
import CtaBand from '../components/CtaBand.astro';
import SketchHero from '../components/SketchHero.astro';
import SketchFrame from '../components/SketchFrame.astro';
import '../styles/home-world.css';
import '../styles/home-story.css';
import '../styles/carousel.css';

import { homePageSchema, SITE } from '../lib/seo';

const steps = [
  {
    title: 'Kennenlernen & Konzept',
    text: 'Erst verstehen, dann gestalten: Im Erstgespräch klären wir Ziele, Zielgruppe und Inhalte. Danach bekommst du ein klares Konzept und ein transparentes Festpreisangebot.',
    check: 'Kostenlos & unverbindlich',
  },
  {
    title: 'Design & Umsetzung',
    text: 'Du siehst regelmäßig sichtbare Zwischenstände und sprichst immer direkt mit der Person, die deine Seite baut – ohne Ticketsysteme und Umwege.',
    check: 'Antwort meist innerhalb von 24 h',
  },
  {
    title: 'Launch & Betreuung',
    text: 'Nach der Qualitätsprüfung geht deine Seite live – schnell geladen, auch mobil. Danach bleibe ich für Updates und neue Funktionen ansprechbar.',
    check: 'Performance von Anfang an',
  },
] as const;

const portrait = responsiveImage(SITE.portrait, 320);

const publishedProjects = await getPublishedProjects();

const featuredSlugs = ['startplatzboerse', 'ohrelauf', 'radsportclub-magdeburg'];
const featuredProjects = featuredSlugs
  .map((slug) => publishedProjects.find((project) => projectSlug(project) === slug))
  .filter((project): project is (typeof publishedProjects)[number] => Boolean(project));
---

<BaseLayout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  jsonLd={homePageSchema(faqItems, Astro.site)}
  headerVariant="paper"
>
<article class="home-world">
  <SketchHero />

  <!-- ═══ Skizze: Planung ═══ -->

  <!-- Ablauf: gezeichnete Schritte auf mintfarbenem Rasterpapier -->
  <section class="plan" id="ablauf" aria-labelledby="plan-title">
    <svg class="pencil-rule pencil-rule--top" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 7 C 180 4, 360 9, 520 6 S 860 4, 1000 8" />
      <path d="M0 10 C 220 8, 420 11, 600 9 S 880 8, 1000 10" />
    </svg>
    <div class="container plan__inner">
      <header class="plan__head autoShow">
        <p class="hand-note">Schritt für Schritt</p>
        <h2 class="story-title" id="plan-title">
          So läuft dein <span class="story-mark">Projekt<svg class="story-mark__line" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9 C 50 5, 120 4, 237 8" /><path d="M8 11.5 C 70 8, 150 8, 230 10" /></svg></span> ab
        </h2>
        <p class="story-lead">
          Drei klare Schritte vom ersten Gespräch bis nach dem Launch. Der erste kostet dich nur ein kurzes Gespräch –
          danach weißt du, was deine Webseite braucht, wie lange es dauert und was es kostet.
        </p>
        <a href="/kontakt/" class="sketch-btn sketch-btn--primary">Erstgespräch anfragen<SketchFrame seed={131} fill /></a>
        <p class="plan__note">Kostenlos · ca. 15 Minuten · Telefon, Video oder vor Ort</p>
      </header>

      <ol class="plan__steps">
        <SketchFrame shape="card" seed={137} />
        {steps.map((step, index) => (
          <li class="plan__step autoShow">
            <span class="plan__num" aria-hidden="true">{index + 1}<SketchFrame shape="circle" seed={141 + index * 4} /></span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <p class="plan__check"><span aria-hidden="true">✓</span> {step.check}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Leistungen: drei Schwerpunkte als gezeichnete Karten, der Rest als „Außerdem möglich“ -->
  <section id="leistungen" class="services-sketch" aria-labelledby="services-title">
    <svg class="pencil-rule pencil-rule--top" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 6 C 200 9, 380 4, 560 7 S 860 9, 1000 5" />
      <path d="M0 9 C 240 11, 440 7, 620 9 S 880 11, 1000 8" />
    </svg>
    <div class="container">
      <header class="story-head story-head--center autoShow">
        <p class="hand-note">Was ich für dich baue</p>
        <h2 class="story-title" id="services-title">Webseite, Relaunch &amp; Betreuung</h2>
        <p class="story-lead">
          Für Vereine, Events und lokale Unternehmen: eine neue Webseite, ein Neustart für die alte –
          und danach jemand, der sich kümmert.
        </p>
      </header>

      <div class="home-carousel" data-carousel>
      <ol class="service-index" data-carousel-track>
        {services.map((service, i) => (
          <li class="service-index__item autoShow">
            <SketchFrame shape="card" seed={50 + i * 7} />
            <span class="service-index__cap" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[service.icon]} />
              <SketchFrame shape="circle" seed={80 + i * 5} />
            </span>
            <h3 class="service-index__title">{service.title}</h3>
            <p class="service-index__text">{service.text}</p>
            <p class="service-index__tags">{service.chips.join(' · ')}</p>
            {service.href && (
              <a class="service-index__link sketch-btn sketch-btn--primary" href={service.href}>Mehr erfahren <span aria-hidden="true">→</span><SketchFrame seed={110 + i * 3} fill /></a>
            )}
          </li>
        ))}
      </ol>
      <div class="carousel-dots carousel-dots--home" role="group" aria-label="Leistungen: Karte wählen">
        {services.map((item, index) => (
          <button type="button" class="carousel-dots__dot" data-carousel-dot={index} aria-label={`${item.title} anzeigen`} aria-current={index === 0 ? 'true' : undefined}></button>
        ))}
      </div>
      </div>

      <div class="services-more-list autoShow">
        <SketchFrame shape="wide" seed={151} />
        <SketchFrame shape="card" seed={153} />
        <p class="hand-note services-more-list__title">Außerdem möglich:</p>
        <ul>
          {moreServices.map((item) => (
            <li>
              <a href={item.href}>
                <strong>{item.title} <span aria-hidden="true">→</span></strong>
                <span>{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <p class="services-more autoShow">
        <a href="/leistungen/" class="sketch-btn sketch-btn--secondary services-cta">
          Alle Leistungen im Überblick <span aria-hidden="true">→</span>
          <SketchFrame seed={61} />
        </a>
      </p>
    </div>
  </section>

  <!-- ═══ Übergang: aus der Skizze wird die Seite ═══ -->
  <section class="story-turn" aria-labelledby="turn-title">
    <h2 class="story-turn__title" id="turn-title">
      <span class="story-turn__sketch">Aus der Skizze</span>
      <span class="story-turn__final">wird die Seite.</span>
    </h2>
    <p class="story-turn__lead">Was als ein paar Striche auf Papier beginnt, ist heute online – zum Beispiel hier:</p>
  </section>

  <!-- ═══ Fertig: Ergebnis ═══ -->
  <div class="story-final">
      <section id="projekte" class="section projects projects--clean">
        <div class="clean-block-head autoShow">
          <h2 class="clean-block-head__title">Referenzen aus Magdeburg &amp; Umgebung</h2>
          <p class="clean-block-head__lead">
            Drei Projekte – von der Vereins-Webseite bis zur Online-Plattform.
          </p>
        </div>
        <div class="home-carousel" data-carousel>
        <div class="card-grid card-grid--clean" data-carousel-track>
        {featuredProjects.map((project, index) => (
          <ProjectCard
            category={project.data.category}
            theme={project.data.theme}
            title={project.data.title}
            description={project.data.subtitle}
            image={project.data.image}
            url={project.data.customerUrl}
            id={projectSlug(project)}
            status={project.data.status}
          />
        ))}
      </div>
        <div class="carousel-dots carousel-dots--home" role="group" aria-label="Referenzen: Karte wählen">
          {featuredProjects.map((item, index) => (
            <button type="button" class="carousel-dots__dot" data-carousel-dot={index} aria-label={`${item.data.title} anzeigen`} aria-current={index === 0 ? 'true' : undefined}></button>
          ))}
        </div>
        </div>
      <p class="projects-more projects-more--clean autoShow">
        <a href="/projekte/" class="projects-more__link">
          Alle Projekte ansehen →
        </a>
      </p>
    </section>

    <section class="candy-about" id="about" aria-labelledby="candy-about-title">
      <div class="container">
        <div class="candy-about__inner">
          <figure class="about-photo autoShow">
            <div class="about-photo__frame">
              <span class="about-photo__img">
              <img
                src={portrait.src}
                srcset={portrait.srcset}
                sizes="(max-width: 899px) min(78vw, 320px), 320px"
                alt="Dustin Rose – Webentwickler in Magdeburg"
                width="320"
                height="400"
                loading="lazy"
                decoding="async"
              />
              </span>
            </div>
            <figcaption class="about-photo__caption">
              <strong>Dustin Rose</strong>
              <span>Webentwicklung · Magdeburg</span>
            </figcaption>
          </figure>

          <article class="candy-about__card autoShow">
            <h2 class="candy-about__title" id="candy-about-title">
              Hi, ich bin <span class="candy-about__name">Dustin</span>.
            </h2>
            <p class="candy-about__role">Webentwickler &amp; Webdesigner</p>
            <div class="candy-about__text">
              <p>Ich verbinde Gestaltung, Technik und schnelle Ladezeiten – ohne Baukasten und ohne unnötige Umwege.</p>
              <p>Von der ersten Idee bis zum Launch bekommst du einen direkten Ansprechpartner und nachvollziehbare Entscheidungen.</p>
            </div>
            <ul class="candy-about__bubbles" aria-label="Schwerpunkte">
              <li>Performance</li>
              <li>Barrierefrei</li>
              <li>Alles aus einer Hand</li>
            </ul>
            <a href="/ueber-mich/" class="candy-about__more">Mehr über mich →</a>
          </article>
        </div>
      </div>
    </section>

    <StyleShowcase />

    <!-- FAQ: ruhige Liste mit Einleitung links -->
    <section id="faq" class="faq-list" aria-labelledby="faq-title">
      <div class="container faq-list__inner">
        <header class="faq-list__head autoShow">
          <h2 class="faq-list__title" id="faq-title">Häufige Fragen zum Webdesign</h2>
          <p class="faq-list__lead">
            Die Antworten auf das, was Vereine und Unternehmen am häufigsten wissen wollen.
            Deine Frage ist nicht dabei?
          </p>
          <a href="/kontakt/" class="faq-list__contact">Frag mich direkt <span aria-hidden="true">→</span></a>
        </header>
        <div class="faq-list__items">
          {faqItems.map((item, i) => (
            <details class="faq-item">
              <summary>
                <span class="faq-item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-item__q">{item.question}</span>
                <span class="faq-item__toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-item__answer"><p>{item.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <CtaBand />
</article>
</BaseLayout>

<script>
  // FAQ: gleichmäßiges Auf- und Zuklappen, immer nur eine Frage offen
  (() => {
    const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq-item')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 280;

    const animate = (item: HTMLDetailsElement, open: boolean) => {
      const answer = item.querySelector<HTMLElement>('.faq-item__answer');
      if (!answer || reduced) {
        item.open = open;
        return;
      }
      item.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      if (open) item.open = true;
      const full = answer.scrollHeight;
      const from = open ? 0 : full;
      const to = open ? full : 0;
      const animation = answer.animate(
        [
          { height: `${from}px`, opacity: open ? 0 : 1 },
          { height: `${to}px`, opacity: open ? 1 : 0 },
        ],
        { duration: DURATION, easing: 'cubic-bezier(0.25, 0.8, 0.25, 1)' },
      );
      if (!open) item.classList.add('is-closing');
      animation.onfinish = () => {
        if (!open) {
          item.open = false;
          item.classList.remove('is-closing');
        }
      };
    };

    items.forEach((item) => {
      item.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault();
        const willOpen = !item.open || item.classList.contains('is-closing');
        if (willOpen) items.filter((other) => other !== item && other.open).forEach((other) => animate(other, false));
        animate(item, willOpen);
      });
    });
  })();
</script>

<script>
  import { initCarousels } from '../scripts/carousel';
  initCarousels();
</script>
