---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import SketchFrame from '../../components/SketchFrame.astro';
import OfferIcon from '../../components/OfferIcon.astro';
import { offers, offerPath, type Offer } from '../../data/offers';
import {
  breadcrumbSchema,
  canonicalUrl,
  faqQuestions,
  offerServiceSchema,
  schemaGraph,
  webPageSchema,
} from '../../lib/seo';
import '../../styles/offer.css';
import '../../styles/faq.css';
import type { MotifName } from '../../lib/sketch';

export function getStaticPaths() {
  return offers.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props as { offer: Offer };
const pathname = offerPath(offer);
const otherOffers = offers.filter((other) => other.slug !== offer.slug && other.kind === offer.kind);
const contactHref = `/kontakt/?thema=${offer.slug}`;

// letztes Wort des Titels wird markiert, z. B. „Webdesign Magdeburg“ → „Magdeburg“
const titleMark = offer.title.split(' ').pop();

// Skizze in der Karte im Seitenkopf – dieselbe wie auf der Übersicht /leistungen/
const motifFor: Record<string, MotifName> = {
  'webdesign-magdeburg': 'browser',
  webentwicklung: 'code',
  'app-entwicklung': 'phones',
  'hosting-betreuung': 'server',
  'seo-check': 'seo',
  relaunch: 'gallery',
  barrierefreiheit: 'cards',
  'business-email': 'mail',
};

// rechte Seite der Abschluss-Karte: Referenzprojekt (mit Screenshot), Technik-Partner –
// oder die Skizze der Leistung, damit die Karte ohne beides nicht leer wirkt
type Side = {
  label: string;
  title: string;
  text: string;
  /** ohne Link: Karte als Kasten statt als Link */
  href?: string;
  linkLabel: string;
  external: boolean;
  image?: string;
};
const side: Side | undefined = offer.reference
  ? {
      label: 'Referenz',
      title: offer.reference.title,
      text: offer.reference.text,
      href: offer.reference.href,
      linkLabel: 'Zum Projekt',
      external: false,
      image: `/og/${offer.reference.href.split('/').filter(Boolean).pop()}.jpg`,
    }
  : offer.partner
    ? {
        label: offer.partner.label ?? 'Technik-Partner',
        title: offer.partner.name,
        text: offer.partner.text,
        href: offer.partner.href,
        linkLabel: offer.partner.linkLabel ?? '',
        external: true,
      }
    : undefined;
const sideSketch = motifFor[offer.slug] ?? 'browser';
const priceText = offer.price ?? 'Festpreis auf Anfrage';
// die ersten drei Punkte aus „Das bekommst du“ stehen schon im Kopf – bei „Stichwort: Text“ nur das Stichwort
const keyPoints = offer.deliverables.slice(0, 3);
---

<BaseLayout
  title={offer.seoTitle}
  description={offer.seoDesc}
  jsonLd={schemaGraph([
    webPageSchema({
      type: ['WebPage', 'FAQPage'],
      name: offer.seoTitle,
      description: offer.seoDesc,
      pathname,
      site: Astro.site,
      about: { '@id': `${canonicalUrl(pathname, Astro.site)}#offer` },
      mainEntity: faqQuestions(offer.faq),
    }),
    offerServiceSchema({
      name: offer.title,
      description: offer.seoDesc,
      pathname,
      site: Astro.site,
    }),
    breadcrumbSchema(
      [
        { name: 'Start', path: '/' },
        { name: 'Leistungen', path: '/leistungen/' },
        { name: offer.title, path: pathname },
      ],
      Astro.site,
    ),
  ])}
>
  <LegalPageShell
    back={{ href: '/leistungen/', label: 'Alle Leistungen' }}
    wide
    legalNav={false}
    crumbs={[{ label: 'Leistungen', href: '/leistungen/' }]}
    title={offer.title}
    mark={titleMark}
    lead={offer.lead}
  >
    <!-- Erster Bildschirm: Kernaussagen und Anfrage links … -->
    <div slot="hero-main" class="hero-offer">
      <ul class="hero-points">
        {keyPoints.map((point) => (
          <li>
            <span class="hero-points__mark" aria-hidden="true">✓</span>
            <span>{point.includes(': ') ? point.split(': ')[0] : point}</span>
          </li>
        ))}
      </ul>
      <div class="hero-actions">
        <a href={contactHref} class="sketch-btn sketch-btn--primary">Projekt anfragen <span aria-hidden="true">→</span><SketchFrame seed={47} fill /></a>
        <a href="#details" class="sketch-btn hero-actions__more">Alle Details <span aria-hidden="true">↓</span><SketchFrame seed={53} /></a>
      </div>
    </div>

    <!-- … Eckdaten und Preis rechts -->
    <article slot="hero" class="hero-product">
      <!-- Skizze wie auf der Leistungsübersicht, auf mintfarbenem Rasterpapier -->
      <div class="hero-product__banner hero-product__banner--sketch" aria-hidden="true">
        <img src={`/sketch/motif-${motifFor[offer.slug] ?? 'browser'}.svg`} alt="" width="420" height="340" decoding="async" />
      </div>
      <div class="hero-product__body">
        <h2 class="hero-product__title">{offer.headings.summary}</h2>
        <dl class="offer-facts">
          {offer.facts.map((fact) => (
            <div class="offer-facts__row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <p class="hero-product__price">
          <span>Preis</span>
          <strong>{priceText}</strong>
        </p>
      </div>
    </article>

    <span id="details" class="offer-anchor" aria-hidden="true"></span>

    {offer.plans?.map((group) => (
      <section class="legal-block offer-plans autoShow" aria-labelledby={`plans-${group.heading}`}>
        <h2 class="legal-block__title" id={`plans-${group.heading}`}>{group.heading}</h2>
        <p class="offer-plans__intro">{group.intro}</p>
        <div class="plan-carousel" data-carousel>
          <ul class:list={['tier-grid', `tier-grid--${group.plans.length}`]} data-carousel-track>
            {group.plans.map((plan, index) => (
              <li class="tier plan-card">
                {group.look === 'stages' ? (
                  <!-- Stufe links, rechts so viele Server übereinander wie die Stufe hoch ist -->
                  <div class="tier__head tier__head--stage">
                    <span class="tier__level">Stufe {index + 1}</span>
                    <span class="tier__servers" aria-hidden="true">
                      {Array.from({ length: index + 1 }, () => (
                        <svg viewBox="0 0 40 12" width="40" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                          <rect x="1" y="1" width="38" height="10" rx="2.5" />
                          <circle cx="7" cy="6" r="1.2" fill="currentColor" stroke="none" />
                          <circle cx="11.5" cy="6" r="1.2" fill="currentColor" stroke="none" />
                          <path d="M20 6h14" />
                        </svg>
                      ))}
                    </span>
                  </div>
                ) : (
                  <div class="tier__head">
                    <span class="tier__icon" aria-hidden="true"><OfferIcon name={offer.icon} size={24} /></span>
                  </div>
                )}
                <h3 class="tier__name">{plan.name}</h3>
                <p class="tier__tagline">{plan.tagline}</p>
                <ul class="tier__features">
                  {plan.features.map((feature) => (
                    <li>
                      {feature.includes(': ') ? (
                        <Fragment><strong>{feature.split(': ')[0]}<span class="plan-card__detail">:</span></strong><span class="plan-card__detail"> {feature.split(': ').slice(1).join(': ')}</span></Fragment>
                      ) : (
                        feature
                      )}
                    </li>
                  ))}
                </ul>
                {plan.variants && <p class="tier__variants">wählbar: {plan.variants.join(' · ')}</p>}
                {plan.features.some((feature) => feature.includes(': ')) && (
                  <button type="button" class="plan-card__toggle" aria-expanded="false" data-plan-toggle>
                    Details anzeigen
                  </button>
                )}
                <a href={`${contactHref}&paket=${encodeURIComponent(plan.name)}`} class="tier__cta">
                  Anfragen<span class="sr-only">: {plan.name}</span>
                  <span class="tier__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="carousel-dots carousel-dots--tiers" role="group" aria-label={`${group.heading}: Karte wählen`}>
            {group.plans.map((plan, index) => (
              <button type="button" class="carousel-dots__dot" data-carousel-dot={index} aria-label={`${plan.name} anzeigen`} aria-current={index === 0 ? 'true' : undefined}></button>
            ))}
          </div>
          <p class="tier-note">{group.look === 'stages' ? 'Alle Stufen' : 'Alle Varianten'}: {priceText}</p>
        </div>
      </section>
    ))}

    <div class="offer-main offer-main--full">
      <article class="legal-block autoShow">
        <h2 class="legal-block__title">{offer.headings.intro}</h2>
        <div class="legal-block__body">
          {offer.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      {offer.sections?.map((section) => (
        <article class="legal-block autoShow">
          <h2 class="legal-block__title">{section.heading}</h2>
          <div class="legal-block__body">
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      ))}

      <article class="legal-block autoShow">
        <h2 class="legal-block__title">{offer.headings.deliverables}</h2>
        <ul class="offer-checklist">
          {offer.deliverables.map((item) => (
            <li>
              <span class="offer-checklist__mark" aria-hidden="true">✓</span>
              <span>
                {item.includes(': ') ? (
                  <Fragment><strong>{item.split(': ')[0]}:</strong> {item.split(': ').slice(1).join(': ')}</Fragment>
                ) : (
                  item
                )}
              </span>
            </li>
          ))}
        </ul>
      </article>

      <article class="legal-block autoShow">
        <h2 class="legal-block__title">{offer.headings.audience}</h2>
        <ul class="legal-list">
          {offer.audience.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="legal-block autoShow">
        <h2 class="legal-block__title">{offer.headings.faq}</h2>
        <div class="faq-list__items">
          {offer.faq.map((item, i) => (
            <details class="faq-item">
              <summary>
                <span class="faq-item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-item__q">{item.question}</span>
                <span class="faq-item__toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-item__answer"><p>{item.answer}</p></div>
            </details>
          ))}
        </div>
      </article>
    </div>

    <!-- Abschluss als geteilte Karte wie die Profilkarte: 60 % Anfrage, 40 % Referenz bzw. Partner -->
    <article class="close-card autoShow">
      <div class="close-card__ask">
        <p class="close-card__kicker">Projekt anfragen</p>
        <h2 class="close-card__title">Interesse an {offer.title}?</h2>
        <p class="close-card__price">{priceText}</p>
        <a href={contactHref} class="sketch-btn sketch-btn--primary close-card__cta">Projekt anfragen <span aria-hidden="true">→</span><SketchFrame seed={59} fill /></a>
      </div>
      <span class="close-card__badge" aria-hidden="true"><img src="/logo-mark.svg" alt="" width="40" height="39" /></span>
      {side && !side.href ? (
          <div class="close-card__side close-card__side--static">
            <span class="close-card__kicker close-card__kicker--light">{side.label}</span>
            <strong class="close-card__side-title">{side.title}</strong>
            <span class="close-card__side-text">{side.text}</span>
          </div>
      ) : side ? (
          <a
            class="close-card__side"
            href={side.href}
            target={side.external ? '_blank' : undefined}
            rel={side.external ? 'noopener' : undefined}
            style={side.image ? `--side-img: url('${side.image}')` : undefined}
          >
            <span class="close-card__kicker close-card__kicker--light">{side.label}</span>
            <strong class="close-card__side-title">{side.title}</strong>
            <span class="close-card__side-text">{side.text}</span>
            <span class="close-card__side-more">
              {side.linkLabel} <span aria-hidden="true">{side.external ? '↗' : '→'}</span>
              {side.external && <span class="sr-only"> (öffnet in neuem Tab)</span>}
            </span>
          </a>
      ) : (
        <div class="close-card__side close-card__side--sketch" aria-hidden="true">
          <img src={`/sketch/motif-${sideSketch}.svg`} alt="" width="420" height="340" loading="lazy" decoding="async" />
        </div>
      )}
    </article>

    <!-- Weitere Leistungen bzw. Pakete: drei nebeneinander, ohne Kästen -->
    <nav class="next-offers autoShow" aria-labelledby="next-offers-title">
      <h2 class="next-offers__title" id="next-offers-title">{offer.kind === 'service' ? 'Weitere Leistungen' : 'Weitere Pakete'}</h2>
      <ul class="next-offers__list">
        {otherOffers.map((other) => (
          <li>
            <a href={offerPath(other)} class="next-offer">
              <span class="next-offer__icon" aria-hidden="true"><OfferIcon name={other.icon} size={24} /></span>
              <strong class="next-offer__name">{other.title}</strong>
              <span class="next-offer__text">{other.teaser}</span>
              <span class="next-offer__more">Ansehen <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </LegalPageShell>
</BaseLayout>

<script>
  import { initCarousels } from '../../scripts/carousel';
  import { initFaq } from '../../scripts/faq';
  initCarousels();
  initFaq();

  // Paketkarten mobil: Erklärungen zu den Stichworten auf- und zuklappen –
  // immer alle Karten einer Gruppe, damit sie gleich hoch bleiben
  document.querySelectorAll<HTMLButtonElement>('[data-plan-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const group = button.closest('.plan-carousel');
      if (!group) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      group.querySelectorAll('.plan-card').forEach((card) => card.classList.toggle('is-open', open));
      group.querySelectorAll<HTMLButtonElement>('[data-plan-toggle]').forEach((other) => {
        other.setAttribute('aria-expanded', String(open));
        other.textContent = open ? 'Details ausblenden' : 'Details anzeigen';
      });
    });
  });
</script>

<style>
  /* ── Abschluss-Karte: geteilt wie die Profilkarte auf /ueber-mich/ ── */
  .close-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    min-height: 17rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    border-radius: 32px 16px 16px 32px;
    background: var(--c-surface);
    box-shadow: 0 30px 60px -30px rgba(27, 38, 44, 0.45), 0 0 0 1px rgba(27, 38, 44, 0.06);
  }

  .close-card__ask {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.75rem, 5vw, 4rem) clamp(1.75rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.75rem);
  }

  .close-card__kicker {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-turf);
  }

  .close-card__kicker--light {
    color: #7fd1ad;
  }

  .close-card__title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    text-wrap: balance;
  }

  .close-card__price {
    margin: 0.6rem 0 0;
    font-weight: 700;
    color: var(--c-slate);
  }

  .close-card__cta {
    margin-top: auto;
    min-height: 48px;
    padding-block: 0;
  }

  .close-card__ask .close-card__cta {
    margin-top: 1.75rem;
  }

  /* Kreis mit dem r³-Zeichen auf der Trennkante */
  .close-card__badge {
    position: absolute;
    top: 50%;
    left: 60%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border: 5px solid var(--c-surface);
    border-radius: 50%;
    background: linear-gradient(140deg, #36a873 0%, var(--c-turf) 55%, var(--c-forest) 100%);
    box-shadow: 0 10px 22px -10px rgba(4, 114, 77, 0.6);
    translate: -50% -50%;
  }

  .close-card__badge img {
    width: 2.1rem;
    height: auto;
  }

  /* rechte Seite: Screenshot der Referenz unter dunklem Verlauf */
  .close-card__side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2rem) clamp(2.75rem, 5vw, 3.5rem);
    border-radius: 0 16px 16px 0;
    text-decoration: none;
    color: #c3d1d6;
    background:
      /* Screenshot nur oben als Andeutung, hinter dem Text eine ruhige, fast deckende Fläche (Lesbarkeit) */
      linear-gradient(180deg, rgba(27, 38, 44, 0.5) 0%, rgba(27, 38, 44, 0.97) 22%, rgb(27, 38, 44) 100%),
      var(--side-img, none) center top / cover no-repeat,
      var(--c-deep);
    transition: filter 0.25s ease;
  }

  /* ohne Referenz: Skizze der Leistung auf mintfarbenem Rasterpapier */
  .close-card__side--sketch {
    display: grid;
    place-items: center;
    padding: 1.5rem 1.75rem 1.5rem 3rem;
    background-color: var(--c-sky);
    background-image:
      repeating-linear-gradient(0deg, rgba(31, 60, 64, 0.1) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(31, 60, 64, 0.1) 0 1px, transparent 1px 28px);
    background-position: center;
  }

  .close-card__side--sketch img {
    width: 100%;
    max-width: 18rem;
    height: auto;
  }

  .close-card__side:not(.close-card__side--sketch, .close-card__side--static):hover {
    filter: brightness(1.08);
  }

  .close-card__side:focus-visible {
    outline: 3px solid var(--c-turf);
    outline-offset: 4px;
  }

  .close-card__side-title {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .close-card__side-text {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .close-card__side-more {
    margin-top: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  @media (max-width: 759px) {
    .close-card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: 28px;
    }

    .close-card__side {
      min-height: 15rem;
      padding: 3.5rem 1.5rem 1.5rem;
      border-radius: 0 0 28px 28px;
    }

    /* Handy: Kreis sitzt auf der Kante zwischen Anfrage und Referenz */
    .close-card__badge {
      position: relative;
      top: auto;
      left: auto;
      width: 4.25rem;
      height: 4.25rem;
      /* Kreismitte = Oberkante der Referenz */
      margin: -2.125rem 0 -2.125rem 1.5rem;
      translate: none;
    }

    .close-card__ask {
      padding-bottom: 3.25rem;
    }
  }

  /* ── Weitere Leistungen: drei nebeneinander ── */
  .next-offers {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .next-offers__title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-ink);
  }

  .next-offers__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .next-offers__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .next-offer {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.4rem 1.25rem;
    border-radius: 22px;
    text-decoration: none;
    background: rgba(184, 219, 217, 0.35);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .next-offer:hover {
    background: rgba(184, 219, 217, 0.65);
    transform: translateY(-3px);
  }

  .next-offer:focus-visible {
    outline: 2px solid var(--c-turf);
    outline-offset: 3px;
  }

  .next-offer__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: #ffffff;
    background: linear-gradient(140deg, #36a873 0%, var(--c-turf) 55%, var(--c-forest) 100%);
    --icon-fill: rgba(255, 255, 255, 0.22);
  }

  .next-offer__name {
    margin-top: 1rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }

  .next-offer__text {
    margin: 0.4rem 0 1rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--c-on-sky);
  }

  .next-offer__more {
    margin-top: auto;
    font-weight: 800;
    /* dunkleres Grün auf der Mint-Fläche: Kontrast deutlich über 4,5 : 1 */
    color: var(--c-forest);
  }

  .next-offer__more span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .next-offer:hover .next-offer__more span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .close-card__side,
    .next-offer,
    .next-offer__more span {
      transition: none;
    }

    .next-offer:hover {
      transform: none;
    }
  }
</style>
