---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import OfferIcon from '../../components/OfferIcon.astro';
import { offers, offerPath } from '../../data/offers';
import { services, moreServices, serviceIcons } from '../../data/services';
import { breadcrumbSchema, schemaGraph, webPageSchema, absoluteUrl } from '../../lib/seo';
import '../../styles/offer.css';

const pageTitle = 'Leistungen – Webdesign Magdeburg | r³webdesign';
const pageDescription =
  'Neue Webseite, Relaunch und Betreuung aus Magdeburg – außerdem Web-Apps, native Apps, SEO-Check, Barrierefreiheits-Check und Business-E-Mail.';

// „Außerdem möglich“ als Karten: gleiche Reihenfolge wie auf der Startseite, Texte aus den Angeboten
const moreOffers = moreServices
  .map((item) => offers.find((offer) => offerPath(offer) === item.href))
  .filter((offer): offer is (typeof offers)[number] => Boolean(offer));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={schemaGraph([
    webPageSchema({
      type: 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      pathname: '/leistungen/',
      site: Astro.site,
      about: { '@id': `${absoluteUrl('/', Astro.site)}#service` },
    }),
    breadcrumbSchema(
      [
        { name: 'Start', path: '/' },
        { name: 'Leistungen', path: '/leistungen/' },
      ],
      Astro.site,
    ),
  ])}
>
  <LegalPageShell
    sketch="cards"
    back={{ href: '/#leistungen', label: 'Zurück zu den Leistungen' }}
    wide
    legalNav={false}
    title="Leistungen"
    lead="Webdesign aus Magdeburg für Vereine, Events und lokale Unternehmen – neue Webseite, Relaunch und Betreuung, persönlich umgesetzt."
  >
    <section class="offer-section" aria-labelledby="services-title">
      <h2 class="offer-section__title" id="services-title">Webseite, Relaunch &amp; Betreuung</h2>
      <p class="offer-section__lead">
        Du startest neu, deine Seite ist in die Jahre gekommen oder du willst dich nicht mehr selbst darum kümmern?
        Ich begleite dein Projekt vom ersten Gespräch bis nach dem Launch – mit einem festen Ansprechpartner und
        einem transparenten Festpreisangebot.
      </p>
      <ul class="service-list service-list--three">
        {services.map((service) => (
          <li class="legal-block service-list__item autoShow">
            <div class="service-card__head">
              <span class="service-list__cap" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[service.icon]} />
              </span>
              <h3 class="legal-block__title">{service.title}</h3>
            </div>
            <p class="service-list__text">{service.text}</p>
            <ul class="service-list__chips" aria-label="Schwerpunkte">
              {service.chips.map((chip) => <li>{chip}</li>)}
            </ul>
            <div class="service-card__foot">
              {service.href ? (
                <a class="service-card__link" href={service.href}>
                  Mehr erfahren<span class="sr-only"> über {service.title}</span> <span aria-hidden="true">→</span>
                </a>
              ) : (
                <a class="service-card__link" href="/kontakt/">
                  Projekt anfragen <span aria-hidden="true">→</span>
                </a>
              )}
              {service.reference && (
                <a class="service-card__ref" href={`/projekte/${service.reference.slug}/`}>
                  Referenz: {service.reference.title}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="offer-section" aria-labelledby="more-title">
      <h2 class="offer-section__title" id="more-title">Außerdem möglich</h2>
      <p class="offer-section__lead">
        Wenn es mehr sein darf als eine Webseite – oder du nur einen bestimmten Teil prüfen lassen willst.
      </p>
      <div class="plan-carousel" data-carousel>
      <div class="offer-more__grid offer-more__grid--four" data-carousel-track>
        {moreOffers.map((offer) => (
          <a href={offerPath(offer)} class="offer-more__card">
            <span class="offer-summary__icon">
              <OfferIcon name={offer.icon} size={22} />
            </span>
            <span>
              <strong>{offer.title}</strong>
              <span>{offer.teaser}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="carousel-dots carousel-dots--more" role="group" aria-label="Weitere Leistungen: Karte wählen">
        {moreOffers.map((offer, index) => (
          <button type="button" class="carousel-dots__dot" data-carousel-dot={index} aria-label={`${offer.title} anzeigen`} aria-current={index === 0 ? 'true' : undefined}></button>
        ))}
      </div>
      </div>
    </section>
  </LegalPageShell>
</BaseLayout>

<script>
  import { initCarousels } from '../../scripts/carousel';
  initCarousels();
</script>
