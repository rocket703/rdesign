---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import OfferIcon from '../../components/OfferIcon.astro';
import { offers, offerPath } from '../../data/offers';
import { services } from '../../data/services';
import { breadcrumbSchema, schemaGraph, webPageSchema, absoluteUrl } from '../../lib/seo';
import '../../styles/offer.css';

const pageTitle = 'Leistungen – Webdesign Magdeburg | r³webdesign';
const pageDescription =
  'Webseiten, Web-Apps, native Apps und Betreuung aus Magdeburg – plus feste Pakete für bestehende Seiten: SEO-Check, Relaunch und Barrierefreiheits-Check.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={schemaGraph([
    webPageSchema({
      type: 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      pathname: '/leistungen/',
      site: Astro.site,
      about: { '@id': `${absoluteUrl('/', Astro.site)}#service` },
    }),
    breadcrumbSchema(
      [
        { name: 'Start', path: '/' },
        { name: 'Leistungen', path: '/leistungen/' },
      ],
      Astro.site,
    ),
  ])}
>
  <LegalPageShell
    wide
    legalNav={false}
    title="Leistungen"
    lead="Webdesign und Webentwicklung aus Magdeburg – von der neuen Webseite bis zur Web-App, persönlich umgesetzt und betreut."
  >
    <section class="offer-section" aria-labelledby="services-title">
      <h2 class="offer-section__title" id="services-title">Neue Webseite, Web-App oder App</h2>
      <p class="offer-section__lead">
        Du startest neu oder brauchst mehr als eine Visitenkarte? Ich begleite dein Projekt vom ersten Gespräch bis
        nach dem Launch – mit einem festen Ansprechpartner und einem transparenten Festpreisangebot.
      </p>
      <ul class="service-list">
        {services.map((service) => (
          <li class="legal-block service-list__item autoShow">
            <h3 class="legal-block__title">{service.title}</h3>
            <p class="service-list__text">{service.text}</p>
            <ul class="service-list__chips" aria-label="Schwerpunkte">
              {service.chips.map((chip) => <li>{chip}</li>)}
            </ul>
            {service.reference && (
              <a class="service-list__ref" href={`/projekte/${service.reference.slug}/`}>
                Referenz: {service.reference.title} →
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="offer-section" aria-labelledby="packages-title">
      <h2 class="offer-section__title" id="packages-title">Feste Pakete für bestehende Webseiten</h2>
      <p class="offer-section__lead">
        Du hast schon eine Webseite? Diese drei Pakete sind einzeln buchbar – mit klarem Ergebnis und Festpreis.
      </p>
      <div class="offer-more__grid offer-more__grid--three">
        {offers.map((offer) => (
          <a href={offerPath(offer)} class="offer-more__card">
            <span class="offer-summary__icon">
              <OfferIcon name={offer.icon} size={22} />
            </span>
            <span>
              <strong>{offer.title}</strong>
              <span>{offer.teaser}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <aside class="legal-block offer-cta-block autoShow">
      <h2 class="legal-block__title">Nicht sicher, was du brauchst?</h2>
      <p class="service-list__text">
        Beschreib kurz dein Vorhaben – im kostenlosen Erstgespräch finden wir gemeinsam die passende Lösung.
      </p>
      <a href="/kontakt/" class="offer-cta">Projekt anfragen</a>
    </aside>
  </LegalPageShell>
</BaseLayout>
