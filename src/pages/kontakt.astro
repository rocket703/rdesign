---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPageShell from '../components/LegalPageShell.astro';
import { responsiveImage } from '../lib/images';
import { SITE, contactPageSchema, personSchema, professionalServiceSchema, schemaGraph } from '../lib/seo';

const pageTitle = 'Kontakt – Webdesign Magdeburg | r³webdesign';
// Kopf-Ausschnitt des Porträts fürs runde Bild
const portrait = responsiveImage('/images/dustin-rose-avatar.webp', 160);
const whatsappUrl = `${SITE.whatsapp}?text=${encodeURIComponent('Hallo Dustin, ich interessiere mich für eine Website.')}`;
const pageDescription =
  'Projektanfrage für Webdesign, Homepage oder Web-App in Magdeburg. Schreib mir dein Vorhaben – ich melde mich zeitnah zurück.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={schemaGraph([
    contactPageSchema({ name: pageTitle, description: pageDescription, site: Astro.site }),
    personSchema(Astro.site),
    professionalServiceSchema(Astro.site),
  ])}
>
  <LegalPageShell
    sketch="mail"
    cta={false}
    legalNav={false}
    wide
    title="Projekt anfragen"
    mark="anfragen"
    crumbLabel="Kontakt"
    lead="Ob Webseite, App oder komplette digitale Lösung – beschreib kurz dein Vorhaben, ich melde mich zeitnah."
  >
    <div slot="hero" class="hero-person">
      <img src={portrait.src} srcset={portrait.srcset} sizes="72px" width="72" height="72" alt="" loading="eager" decoding="async" />
      <div>
        <p class="hero-person__name">Dustin Rose</p>
        <p class="hero-person__role">Webdesign &amp; Webentwicklung · Magdeburg</p>
        <p class="hero-person__live">Antwort meist innerhalb von 24 h</p>
      </div>
    </div>

    <!-- Eine geteilte Karte wie die Profilkarte: links das Formular, rechts die direkten Wege -->
    <article class="contact-card autoShow">
      <div class="contact-card__form legal-block--form">
        <h2 class="contact-card__title">Nachricht schreiben</h2>

        <form
          data-contact-email={SITE.email}
          action="https://www.systory.de/v1/formulare/kontaktformular-r-webdesign-7abcb2/einreichen"
          method="POST"
          class="contact-form"
          novalidate
        >
          <!-- Spam-Falle: bleibt für Menschen unsichtbar und leer -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="display: none;" />

          <div class="form-group float-field">
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder=" "
              autocomplete="name"
              class="form-input"
            />
            <label for="name">Name</label>
            <span class="error-msg" id="name-error">Bitte gib deinen Namen ein.</span>
          </div>

          <div class="form-group float-field">
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder=" "
              autocomplete="email"
              class="form-input"
            />
            <label for="email">E-Mail</label>
            <span class="error-msg" id="email-error">Bitte gib eine gültige E-Mail-Adresse ein.</span>
          </div>

          <div class="form-group float-field float-field--textarea">
            <textarea
              id="message"
              name="message"
              required
              placeholder=" "
              rows="6"
              class="form-textarea"
            ></textarea>
            <label for="message">Nachricht</label>
            <span class="error-msg" id="message-error">Bitte schreib mir eine Nachricht.</span>
          </div>

          <div class="form-group checkbox-group">
            <label class="checkbox-label">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="form-checkbox"
                aria-describedby="privacy-error"
              />
              <span>
                Ich habe die <a href="/datenschutz/" class="legal-link">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Angaben zur Kontaktaufnahme zu.
              </span>
            </label>
            <span class="error-msg" id="privacy-error">Bitte bestätige die Datenschutzerklärung.</span>
          </div>

          <button type="submit" class="submit-button">
            <span class="btn-text">Nachricht senden</span>
            <span class="btn-loader"></span>
          </button>

          <div id="form-status" class="form-notice" role="status" aria-live="polite" aria-atomic="true" hidden>
            <span class="form-notice__icon" aria-hidden="true"></span>
            <p class="form-notice__body">
              <strong class="form-notice__title"></strong>
              <span class="form-notice__text"></span>
            </p>
          </div>
        </form>
      </div>

      <span class="contact-card__badge" aria-hidden="true"><img src="/logo-mark.svg" alt="" width="36" height="35" /></span>

      <aside class="contact-card__info" aria-label="Direkt erreichen">
        <ul class="contact-ways">
          <li>
            <span class="contact-ways__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></svg>
            </span>
            <div>
              <h3>Direkt erreichen</h3>
              <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />Antwort meist innerhalb von 24 Stunden.</p>
            </div>
          </li>
          <li>
            <span class="contact-ways__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="2.5" width="11" height="19" rx="2.2" /><path d="M10.5 18.5h3" /></svg>
            </span>
            <div>
              <h3>Telefon &amp; WhatsApp</h3>
              <p><a href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a></p>
              <a class="contact-wa" href={whatsappUrl} target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5l1.2-4.2a8.5 8.5 0 1 1 3.1 3z" /><path d="M9.2 8.6c.2-.5.6-.6.9-.6h.4l1 2.2-.6.8c.4.9 1.2 1.7 2.1 2.1l.8-.6 2.2 1v.4c0 .3-.1.7-.6.9-.6.3-1.5.3-2.7-.3a7.5 7.5 0 0 1-3.2-3.2c-.6-1.2-.6-2.1-.3-2.7z" fill="currentColor" stroke="none" /></svg>
                WhatsApp schreiben
              </a>
            </div>
          </li>
          <li>
            <span class="contact-ways__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
            </span>
            <div>
              <h3>Kostenloses Erstgespräch</h3>
              <p>In rund 15 Minuten klären wir, was du brauchst – per Telefon, Video oder persönlich in Magdeburg.</p>
            </div>
          </li>
          <li>
            <span class="contact-ways__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg>
            </span>
            <div>
              <h3>Standort &amp; Einzugsgebiet</h3>
              <p>{SITE.streetAddress}, {SITE.postalCode} {SITE.city}<br />Vor Ort in {SITE.serviceArea.join(', ')} – remote deutschlandweit.</p>
            </div>
          </li>
        </ul>
      </aside>
    </article>
  </LegalPageShell>

  <div
    id="success-popup"
    class="contact-popup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="success-popup-title"
    aria-hidden="true"
  >
    <div class="contact-popup__card">
      <div class="contact-popup__icon" aria-hidden="true">
        <svg class="check-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40" aria-hidden="true" focusable="false">
          <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2 id="success-popup-title">Nachricht gesendet!</h2>
      <p>Vielen Dank für deine Anfrage. Ich habe deine Nachricht erhalten und melde mich in Kürze.</p>
      <button type="button" id="close-popup" class="contact-popup__close">Zurück zur Seite</button>
    </div>
  </div>
</BaseLayout>

<script>
  import { offers } from '../data/offers';

  // Anfrage von einer Schnellstart-Seite: Nachricht mit dem Thema vorbelegen
  const params = new URLSearchParams(window.location.search);
  const topic = params.get('thema');
  // optional: gewählter Tarif, z. B. „Mittel“ (Hosting & Betreuung)
  const plan = params.get('paket');
  const offer = offers.find((item) => item.slug === topic);
  const messageField = document.querySelector<HTMLTextAreaElement>('#message');
  if (offer && messageField && !messageField.value) {
    const planName = plan && offer.plans?.some((group) => group.plans.some((item) => item.name === plan)) ? ` – ${plan}` : '';
    messageField.value = `Hallo Dustin, ich interessiere mich für: ${offer.title}${planName}.\n\n`;
  }
</script>

<script>
  const form = document.querySelector('.contact-form');
  const popup = document.getElementById('success-popup');
  const closeBtn = document.getElementById('close-popup');
  const submitBtn = document.querySelector('.submit-button');
  const btnText = document.querySelector('.btn-text');
  const popupIcon = document.querySelector('.contact-popup__icon');
  const formStatus = document.getElementById('form-status');
  const inputs = document.querySelectorAll('.form-input, .form-textarea, .form-checkbox');
  let popupReturnFocus = null;

  const fieldErrorId = {
    name: 'name-error',
    email: 'email-error',
    message: 'message-error',
    privacy: 'privacy-error',
  };

  const contactEmail = form?.dataset.contactEmail ?? '';
  const noticeIcons = { success: '✓', error: '!' };

  // Sichtbare Meldung unter dem Button; tone: 'success' | 'error'
  const setFormStatus = (title, text = '', tone = 'error') => {
    if (!formStatus) return;
    if (!title) {
      formStatus.hidden = true;
      return;
    }
    formStatus.dataset.tone = tone;
    formStatus.querySelector('.form-notice__icon').textContent = noticeIcons[tone];
    formStatus.querySelector('.form-notice__title').textContent = title;
    formStatus.querySelector('.form-notice__text').textContent = text;
    formStatus.hidden = false;
  };

  const spawnRipple = (e) => {
    if (!submitBtn || submitBtn.disabled) return;
    const rect = submitBtn.getBoundingClientRect();
    const ripple = document.createElement('span');
    ripple.className = 'btn-ripple';
    const size = Math.max(rect.width, rect.height);
    ripple.style.width = ripple.style.height = size + 'px';
    ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
    ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
    submitBtn.appendChild(ripple);
    ripple.addEventListener('animationend', () => ripple.remove());
  };

  submitBtn?.addEventListener('pointerdown', spawnRipple);

  const clearFieldError = (input) => {
    const group = input.closest('.form-group');
    group?.classList.remove('error');
    input.removeAttribute('aria-invalid');
    const errorId = fieldErrorId[input.name] || fieldErrorId[input.id];
    if (errorId && input.getAttribute('aria-describedby') === errorId) {
      input.removeAttribute('aria-describedby');
    }
  };

  const validateField = (input) => {
    const group = input.closest('.form-group');
    const errorId = fieldErrorId[input.name] || fieldErrorId[input.id];
    if (!input.checkValidity()) {
      group?.classList.add('error');
      input.setAttribute('aria-invalid', 'true');
      if (errorId) input.setAttribute('aria-describedby', errorId);
      return false;
    }
    clearFieldError(input);
    return true;
  };

  inputs.forEach((input) => {
    input.addEventListener('input', () => clearFieldError(input));
    input.addEventListener('change', () => clearFieldError(input));
  });

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      let isValid = true;
      inputs.forEach((input) => {
        if (!validateField(input)) isValid = false;
      });

      if (!isValid) {
        form.classList.add('shake');
        setTimeout(() => form.classList.remove('shake'), 500);
        setFormStatus('Bitte prüf die markierten Felder.', 'Name, E-Mail, Nachricht und die Zustimmung zur Datenschutzerklärung sind Pflicht.');
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        firstInvalid?.focus();
        return;
      }

      setFormStatus('');
      submitBtn.classList.add('loading');
      btnText.textContent = 'Wird gesendet...';
      submitBtn.disabled = true;

      const field = (name) => form.elements.namedItem(name);

      try {
        // Bot hat die Spam-Falle ausgefüllt: Erfolg vortäuschen, nichts senden
        if (field('website')?.value.trim()) {
          form.reset();
          return;
        }

        // Schlüssel müssen exakt den Feldbezeichnungen im Mailtory-Formular entsprechen
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            data: {
              name: field('name').value.trim(),
              email: field('email').value.trim(),
              message: field('message').value.trim(),
              privacy: `Zugestimmt am ${new Date().toLocaleString('de-DE')}`,
            },
          }),
        });
        let data = null;
        try {
          data = await response.json();
        } catch {
          data = null;
        }

        if (response.ok && data?.ok !== false) {
          form.reset();
          inputs.forEach((input) => clearFieldError(input));
          setFormStatus('Danke, deine Nachricht ist angekommen.', 'Ich melde mich in der Regel innerhalb von 24 Stunden bei dir.', 'success');
          popupReturnFocus = submitBtn;
          popup?.classList.add('is-visible');
          popup?.setAttribute('aria-hidden', 'false');
          popupIcon?.classList.add('success-pulse');
          setTimeout(() => popupIcon?.classList.remove('success-pulse'), 800);
          closeBtn?.focus();
        } else {
          // Mailtory liefert bei Fehlern einen lesbaren Grund mit (z. B. bei zu vielen Anfragen)
          const reason = typeof data?.error === 'string' && data.error.trim() ? data.error.trim() : 'Bitte versuch es gleich noch einmal.';
          setFormStatus(
            'Deine Nachricht konnte nicht gesendet werden.',
            `${reason} Du kannst mir auch direkt an ${contactEmail} schreiben.`,
          );
        }
      } catch (error) {
        setFormStatus(
          'Keine Verbindung zum Server.',
          `Prüf bitte deine Internetverbindung und versuch es erneut – oder schreib mir direkt an ${contactEmail}.`,
        );
        console.error(error);
      } finally {
        submitBtn.classList.remove('loading');
        btnText.textContent = 'Nachricht senden';
        submitBtn.disabled = false;
      }
    });
  }

  const closePopup = () => {
    popup?.classList.remove('is-visible');
    popup?.setAttribute('aria-hidden', 'true');
    popupReturnFocus?.focus();
    popupReturnFocus = null;
  };

  closeBtn?.addEventListener('click', closePopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closePopup();
  });

  if (popup) {
    popup.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = popup.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popup?.classList.contains('is-visible')) closePopup();
  });
</script>

<style>
  /* ── Geteilte Kontakt-Karte: Formular links, Kontaktwege rechts (wie die Profilkarte) ── */
  .contact-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    border-radius: 32px 16px 16px 32px;
    background: var(--c-surface);
    box-shadow: 0 30px 60px -30px rgba(27, 38, 44, 0.45), 0 0 0 1px rgba(27, 38, 44, 0.06);
  }

  .contact-card__form {
    min-width: 0;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.75rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.75rem);
  }

  .contact-card__title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }

  .contact-card__badge {
    position: absolute;
    top: 2.25rem;
    left: 60%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 5px solid var(--c-surface);
    border-radius: 50%;
    background: linear-gradient(140deg, #36a873 0%, var(--c-turf) 55%, var(--c-forest) 100%);
    box-shadow: 0 10px 22px -10px rgba(4, 114, 77, 0.6);
    translate: -50% 0;
  }

  .contact-card__badge img {
    width: 2rem;
    height: auto;
  }

  .contact-card__info {
    padding: clamp(5.5rem, 9vw, 6.5rem) clamp(1.5rem, 4vw, 2.25rem) clamp(1.75rem, 4vw, 2.5rem) clamp(2.25rem, 4vw, 3rem);
    border-radius: 0 16px 16px 0;
    color: #c3d1d6;
    background:
      radial-gradient(ellipse 80% 60% at 100% 0%, rgba(4, 114, 77, 0.45), transparent 60%),
      var(--c-deep);
  }

  .contact-ways {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-ways li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1rem;
  }

  .contact-ways__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: #7fd1ad;
    background: rgba(255, 255, 255, 0.08);
  }

  .contact-ways h3 {
    margin: 0.2rem 0 0.3rem;
    font-size: 1.02rem;
    font-weight: 800;
    color: #ffffff;
  }

  .contact-ways p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .contact-ways a {
    font-weight: 700;
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: rgba(127, 209, 173, 0.6);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .contact-ways .contact-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.75rem;
    padding: 0.55rem 1.05rem 0.55rem 0.85rem;
    border: 1.5px solid rgba(127, 209, 173, 0.55);
    border-radius: 999px;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
    background: rgba(127, 209, 173, 0.1);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .contact-wa svg {
    flex-shrink: 0;
    color: #7fd1ad;
  }

  .contact-ways .contact-wa:hover {
    border-color: #7fd1ad;
    background: rgba(127, 209, 173, 0.2);
  }

  .contact-ways a:focus-visible {
    outline: 2px solid #7fd1ad;
    outline-offset: 2px;
  }

  /* Formularfelder: ruhige, gefüllte Flächen */
  .contact-card :global(.contact-form .form-input),
  .contact-card :global(.contact-form .form-textarea) {
    border: 1.5px solid transparent;
    border-radius: 14px;
    color: var(--c-ink);
    background: var(--c-bg);
  }

  .contact-card :global(.contact-form .form-input:focus),
  .contact-card :global(.contact-form .form-textarea:focus) {
    border-color: var(--c-turf);
    background: #ffffff;
  }

  .contact-card :global(.contact-form .submit-button) {
    align-self: flex-start;
    width: auto;
    min-height: 50px;
    padding: 0 1.75rem;
    border: none;
    border-radius: 12px;
    color: #ffffff;
    background: var(--c-turf);
    box-shadow: 0 12px 24px -14px rgba(4, 114, 77, 0.8);
  }

  .contact-card :global(.contact-form .submit-button:hover:not(:disabled)) {
    background: var(--c-forest);
  }

  @media (max-width: 859px) {
    .contact-card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: 28px;
    }

    .contact-card :global(.contact-form .submit-button) {
      align-self: stretch;
    }

    /* Handy: Kreis auf der Kante zwischen Formular und Kontaktwegen */
    .contact-card__badge {
      position: relative;
      top: auto;
      left: auto;
      width: 4.25rem;
      height: 4.25rem;
      margin: -2.125rem 0 -2.125rem 1.5rem;
      translate: none;
    }

    .contact-card__form {
      padding-bottom: 3.25rem;
    }

    .contact-card__info {
      padding: 3.5rem 1.5rem 1.75rem;
      border-radius: 0 0 28px 28px;
    }
  }

  /* Ripple und Ladekreis entstehen bzw. wechseln per Skript – daher :global, sonst greift der Stil nicht */
  .submit-button :global(.btn-ripple) {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    transform: scale(0);
    animation: btnRipple 0.65s ease-out forwards;
    pointer-events: none;
  }

  @keyframes btnRipple {
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  /* Rückmeldung unter dem Button: Erfolg grün, Fehler rot */
  .form-notice {
    --notice: #b42318;
    --notice-bg: #fef3f2;
    --notice-line: rgba(180, 35, 24, 0.28);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--notice-line);
    border-radius: 14px;
    background: var(--notice-bg);
    animation: noticeIn 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .form-notice[hidden] {
    display: none;
  }

  .form-notice[data-tone='success'] {
    --notice: var(--c-turf);
    --notice-bg: #ecf7f2;
    --notice-line: rgba(4, 114, 77, 0.28);
  }

  .form-notice__icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
