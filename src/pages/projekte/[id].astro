---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedProjects, projectSlug } from '../../lib/projects';
import DeviceShowcase from '../../components/DeviceShowcase.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import SketchFrame from '../../components/SketchFrame.astro';
import TechIcons from '../../components/TechIcons.astro';
import '../../styles/offer.css';
import { isInProgress, statusLabel } from '../../lib/project-status';
import { offers, offerPath } from '../../data/offers';
import {
  breadcrumbSchema,
  canonicalUrl,
  creativeWorkSchema,
  schemaGraph,
  webPageSchema,
} from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { id: projectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectLink = project.data.customerUrl;
const projectStatus = project.data.status;
const statusText = statusLabel(projectStatus);
const inProgress = isInProgress(projectStatus);
const relatedOffer = offers.find((offer) => offer.slug === project.data.relatedOffer);
const related = relatedOffer
  ? { href: offerPath(relatedOffer), label: relatedOffer.title }
  : { href: '/leistungen/', label: 'Alle Leistungen' };
const title = project.data.title;
const slug = projectSlug(project);
const projectPath = `/projekte/${slug}/`;
const pageTitle = project.data.seoTitle ?? `${project.data.title} | r³webdesign`;
const pageDescription = project.data.seoDesc ?? project.data.subtitle;
const liveHost = (() => {
  try {
    return new URL(projectLink).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
})();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={`/og/${slug}.jpg`}
  imageAlt={`Vorschau der Webseite ${project.data.title}`}
  jsonLd={schemaGraph([
    webPageSchema({
      name: pageTitle,
      description: pageDescription,
      pathname: projectPath,
      site: Astro.site,
      mainEntity: { '@id': `${canonicalUrl(projectPath, Astro.site)}#project` },
    }),
    breadcrumbSchema(
      [
        { name: 'Start', path: '/' },
        { name: 'Projekte', path: '/projekte/' },
        { name: project.data.title, path: projectPath },
      ],
      Astro.site,
    ),
    creativeWorkSchema({
      title: project.data.title,
      description: pageDescription,
      image: project.data.image,
      pathname: projectPath,
      liveUrl: projectLink,
      keywords: project.data.techStack,
      status: inProgress ? statusText : undefined,
      site: Astro.site,
    }),
  ])}
>
  <LegalPageShell
    sketch="browser"
    back={{ href: '/projekte/', label: 'Alle Projekte' }}
    wide
    legalNav={false}
    crumbs={[{ label: 'Projekte', href: '/projekte/' }]}
    status={inProgress ? 'In Arbeit' : undefined}
    title={project.data.title}
    lead={project.data.subtitle}
  >
    {inProgress && (
      <p class="project-wip-note">
        Dieses Projekt ist noch in Arbeit – Inhalte und Funktionen werden gerade ergänzt.
      </p>
    )}

    <!-- Oben: Vorschau links, Eckdaten fest daneben -->
    <div class="project-top">
      <div class="project-showcase" role="group" aria-label="Projektvorschau">
        {liveHost ? (
          <a href={projectLink} target="_blank" rel="noopener noreferrer" class="project-showcase__link">
            <DeviceShowcase
              desktop={project.data.image}
              mobile={project.data.imageMobile}
              title={project.data.title}
              sizes="(max-width: 900px) calc(100vw - 2.5rem), 680px"
              priority
            />
            <span class="project-showcase__hint">
              Webseite ansehen <span aria-hidden="true">↗</span>
            </span>
          </a>
        ) : (
          <!-- ohne öffentliche Adresse (z. B. noch im Aufbau): Vorschau ohne Link -->
          <DeviceShowcase
            desktop={project.data.image}
            mobile={project.data.imageMobile}
            title={project.data.title}
            sizes="(max-width: 900px) calc(100vw - 2.5rem), 680px"
            priority
          />
        )}
        {project.data.mobileNote && <p class="project-showcase__note">{project.data.mobileNote}</p>}
      </div>

      <!-- Eckdaten als Karte im Stil der Profil- und Abschluss-Karte -->
      <aside class="project-specs autoShow">
        <div class="project-specs__head">
          <span class="project-specs__badge" aria-hidden="true"><img src="/logo-mark.svg" alt="" width="26" height="25" /></span>
          <h2 class="project-specs__title">Eckdaten</h2>
        </div>
          <dl class="offer-facts">
            <div class="offer-facts__row">
              <dt>Status</dt>
              <dd>{statusText}</dd>
            </div>
            {liveHost ? (
              <div class="offer-facts__row">
                <dt>Webseite</dt>
                <dd><a href={projectLink} target="_blank" rel="noopener noreferrer" class="legal-link">{liveHost}</a></dd>
              </div>
            ) : null}
            <div class="offer-facts__row">
              <dt>Umsetzung</dt>
              <dd>r³webdesign, Magdeburg</dd>
            </div>
          </dl>
          {project.data.techStack?.length ? (
            <TechIcons tags={project.data.techStack} class="project-tech" />
          ) : null}
          <a href="/kontakt/" class="sketch-btn sketch-btn--primary project-specs__cta">Projekt anfragen <span aria-hidden="true">→</span><SketchFrame seed={67} fill /></a>
          <a href={related.href} class="project-specs__related">
            <span>Passende Leistung</span>
            <strong>{related.label}</strong>
            <span class="project-specs__arrow" aria-hidden="true">→</span>
          </a>
      </aside>
    </div>

    <!-- Darunter: Beschreibung, Überschrift links und Text rechts wie auf den anderen Unterseiten -->
    <article class="legal-block project-about autoShow">
      <h2 class="legal-block__title">Über das Projekt</h2>
      <div class="legal-block__body project-prose">
        <Content />
      </div>
    </article>
  </LegalPageShell>
</BaseLayout>

<style>

  .project-wip-note {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-weight: 600;
    color: #713f12;
    background: #fef3c7;
    border: 1px solid #fcd34d;
  }

  .project-top {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .project-top {
      grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.85fr);
    }

  }

  .project-specs {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.4rem;
    border-radius: 24px;
    background: var(--c-surface);
    box-shadow: 0 0 0 1px rgba(27, 38, 44, 0.06), 0 26px 48px -28px rgba(27, 38, 44, 0.45);
  }

  .project-specs__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .project-specs__badge {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: linear-gradient(140deg, #36a873 0%, var(--c-turf) 55%, var(--c-forest) 100%);
  }

  .project-specs__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }

  .project-specs__cta {
    align-self: flex-start;
    margin-top: 1.1rem;
    min-height: 48px;
    padding-block: 0;
  }

  .project-specs__related {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 0.75rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    text-decoration: none;
    background: rgba(184, 219, 217, 0.4);
    transition: background 0.2s ease;
  }

  .project-specs__related:hover {
    background: rgba(184, 219, 217, 0.7);
  }

  .project-specs__related:focus-visible {
    outline: 2px solid var(--c-turf);
    outline-offset: 2px;
  }

  .project-specs__related span:first-child {
    grid-column: 1;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-turf);
  }

  .project-specs__related strong {
    grid-column: 1;
    font-weight: 800;
    color: var(--c-ink);
  }

  .project-specs__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: #ffffff;
    background: var(--c-turf);
  }

  .project-showcase {
    min-width: 0;
  }

  .project-about {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project-showcase__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-showcase__hint {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--pg-link);
  }

  .project-showcase__note {
    max-width: 60ch;
    margin: 0.75rem 0 0;
    line-height: 1.6;
    color: var(--pg-text);
  }

  .project-prose :global(strong) {
    color: var(--pg-text-strong);
  }

  .project-prose :global(p) {
    margin: 0 0 1rem;
    font-size: 1.04rem;
    line-height: 1.75;
    color: var(--c-on-sky);
  }

  /* Zwischenüberschriften: Ausgangslage, Umsetzung, Nutzen */
  .project-prose :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--pg-text-strong);
  }

  .project-prose :global(h3:first-child) {
    margin-top: 0;
  }

  .project-prose :global(ul) {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .project-prose :global(li) {
    position: relative;
    padding-left: 1.6rem;
    font-size: 1.04rem;
    line-height: 1.65;
    color: var(--c-on-sky);
  }

  .project-prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.55em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--c-turf);
  }

  :global(.project-tech) {
    --tech-icon-bg: #f1f5f9;
    --tech-icon-border: #e2e8f0;
    --tech-icon-color: #475569;
    margin: 0.25rem 0 1.25rem;
  }
</style>
