---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import '../../styles/offer.css';
import { getPublishedProjects, projectSlug } from '../../lib/projects';
import {
  PORTFOLIO,
  portfolioPageSchema,
  type ProjectListItem,
} from '../../lib/seo';

const publishedProjects = await getPublishedProjects();

const sortedProjects = [...publishedProjects].sort((a, b) => {
  const onlineFirst = (status: string) => (status.toLowerCase() === 'online' ? 0 : 1);
  const byStatus = onlineFirst(a.data.status) - onlineFirst(b.data.status);
  if (byStatus !== 0) return byStatus;
  return a.data.title.localeCompare(b.data.title, 'de');
});

const projectListItems: ProjectListItem[] = sortedProjects.map((project) => ({
  title: project.data.title,
  slug: projectSlug(project),
  description: project.data.subtitle,
  image: project.data.image,
}));
---

<BaseLayout
  title={PORTFOLIO.title}
  description={PORTFOLIO.description}
  jsonLd={portfolioPageSchema(projectListItems, Astro.site)}
>
  <LegalPageShell
    back={{ href: '/#projekte', label: 'Zurück zu den Referenzen' }}
    xwide
    legalNav={false}
    title="Referenzprojekte aus Magdeburg"
    mark="Magdeburg"
    crumbLabel="Projekte"
    lead="Webseiten, Apps und Plattformen aus Magdeburg und Umgebung – von schlanken Landingpages bis zu Plattformen mit Login und eigenem Verwaltungsbereich."
  >
    <div class="card-grid portfolio-grid">
      {sortedProjects.map((project, index) => (
        <ProjectCard
          category={project.data.category}
          accent={index}
          title={project.data.title}
          description={project.data.subtitle}
          image={project.data.image}
          tags={project.data.techStack}
          id={projectSlug(project)}
          headingLevel={2}
          status={project.data.status}
        />
      ))}
    </div>
  </LegalPageShell>
</BaseLayout>

<style>
  .portfolio-grid {
    margin-top: 0;
    gap: 1.5rem;
  }
</style>
