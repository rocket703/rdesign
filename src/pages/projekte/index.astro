---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import LegalPageShell from '../../components/LegalPageShell.astro';
import '../../styles/offer.css';
import '../../styles/carousel.css';
import { getPublishedProjects, projectSlug } from '../../lib/projects';
import {
  PORTFOLIO,
  portfolioPageSchema,
  type ProjectListItem,
} from '../../lib/seo';

const publishedProjects = await getPublishedProjects();

const sortedProjects = [...publishedProjects].sort((a, b) => {
  const onlineFirst = (status: string) => (status.toLowerCase() === 'online' ? 0 : 1);
  const byStatus = onlineFirst(a.data.status) - onlineFirst(b.data.status);
  if (byStatus !== 0) return byStatus;
  return a.data.title.localeCompare(b.data.title, 'de');
});

const projectListItems: ProjectListItem[] = sortedProjects.map((project) => ({
  title: project.data.title,
  slug: projectSlug(project),
  description: project.data.subtitle,
  image: project.data.image,
}));
---

<BaseLayout
  title={PORTFOLIO.title}
  description={PORTFOLIO.description}
  jsonLd={portfolioPageSchema(projectListItems, Astro.site)}
>
  <LegalPageShell
    sketch="gallery"
    back={{ href: '/#projekte', label: 'Zurück zu den Referenzen' }}
    xwide
    legalNav={false}
    title="Referenzprojekte aus Magdeburg"
    mark="Magdeburg"
    crumbLabel="Projekte"
    lead="Webseiten, Apps und Plattformen aus Magdeburg und Umgebung – von schlanken Landingpages bis zu Plattformen mit Login und eigenem Verwaltungsbereich."
  >
    <!-- Mobil: Projekte zum Wischen mit Punkten -->
    <div class="portfolio-carousel" data-carousel>
    <div class="card-grid portfolio-grid" data-carousel-track>
      {sortedProjects.map((project, index) => (
        <ProjectCard
          category={project.data.category}
          accent={index}
          title={project.data.title}
          description={project.data.subtitle}
          image={project.data.image}
          tags={project.data.techStack}
          id={projectSlug(project)}
          headingLevel={2}
          status={project.data.status}
        />
      ))}
    </div>
      <div class="carousel-dots portfolio-dots" role="group" aria-label="Projekte: Karte wählen">
        {sortedProjects.map((project, index) => (
          <button type="button" class="carousel-dots__dot" data-carousel-dot={index} aria-label={`${project.data.title} anzeigen`} aria-current={index === 0 ? 'true' : undefined}></button>
        ))}
      </div>
    </div>
  </LegalPageShell>
</BaseLayout>

<style>
  .portfolio-grid {
    margin-top: 0;
    gap: 1.5rem;
  }

  .portfolio-carousel {
    min-width: 0;
    max-width: 100%;
  }

  /* Mobil (einspaltig bis 819 px): Wischleiste bis an den Bildschirmrand,
     Bänder der Projektkarten ragen 18 px über – daher Abstand und Innenrand */
  @media (max-width: 819px) {
    .portfolio-grid {
      display: flex;
      gap: 2.5rem;
      margin-inline: calc(50% - 50vw);
      padding: 0.5rem 2rem 1.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 2rem;
      scrollbar-width: none;
    }

    .portfolio-grid::-webkit-scrollbar {
      display: none;
    }

    .portfolio-grid > :global(*) {
      flex: 0 0 var(--swipe-card);
      min-width: 0;
      height: auto;
      align-self: stretch;
      scroll-snap-align: center;
    }

    .portfolio-dots {
      display: flex;
    }
  }
</style>

<script>
  import { initCarousels } from '../../scripts/carousel';
  initCarousels();
</script>
