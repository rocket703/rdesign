---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPageShell from '../components/LegalPageShell.astro';
import { siGithub } from 'simple-icons';
import { responsiveImage } from '../lib/images';
import { SITE, absoluteUrl, breadcrumbSchema, personSchema, schemaGraph, webPageSchema } from '../lib/seo';
import '../styles/offer.css';

const pageTitle = 'Über mich – Dustin Rose, Webentwickler | r³webdesign';
const pageDescription =
  'Dustin Rose, Webentwickler und Webdesigner aus Magdeburg: seit 2020 Webseiten, Web-Apps und Server-Betrieb, zertifiziert in Responsive Web Design.';
const portrait = responsiveImage(SITE.portrait, 320);

const skills = [
  { title: 'Gestaltung', items: ['Webdesign', 'Responsive Design', 'Barrierefreiheit', 'UX'] },
  { title: 'Entwicklung', items: ['HTML & CSS', 'JavaScript', 'TypeScript', 'Astro', 'React Native', 'Supabase', 'PostgreSQL'] },
  { title: 'Sichtbarkeit', items: ['Technisches SEO', 'Strukturierte Daten', 'Ladezeiten', 'Core Web Vitals'] },
  { title: 'Betrieb', items: ['Linux-Server', 'Docker', 'Proxmox', 'Monitoring', 'Backups', 'GitHub Actions'] },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={schemaGraph([
    webPageSchema({
      type: 'ProfilePage',
      name: pageTitle,
      description: pageDescription,
      pathname: '/ueber-mich/',
      site: Astro.site,
      mainEntity: { '@id': `${absoluteUrl('/', Astro.site)}#person` },
    }),
    personSchema(Astro.site),
    breadcrumbSchema(
      [
        { name: 'Start', path: '/' },
        { name: 'Über mich', path: '/ueber-mich/' },
      ],
      Astro.site,
    ),
  ])}
>
  <LegalPageShell
    sketch="desk"
    back={{ href: '/#about', label: 'Zurück zur Startseite' }}
    wide
    legalNav={false}
    title="Hi, ich bin Dustin"
    mark="Dustin"
    crumbLabel="Über mich"
    lead="Ich bin Dustin Rose – Webentwickler und Webdesigner aus Magdeburg. Unter r³webdesign entwickle ich Webseiten und Web-Apps, bei denen Gestaltung, Technik und Ladezeit zusammenpassen."
  >
    <!-- Profilkarte: Foto füllt die linke Seite, r³-Zeichen im Kreis auf der Kante, rechts Name und Kontaktwege -->
    <div class="offer-aside about-intro">
      <article class="profile-card autoShow">
        <div class="profile-card__photo">
          <img
            src={portrait.src}
            srcset={portrait.srcset}
            sizes="(max-width: 699px) 92vw, 300px"
            width={portrait.width}
            height={portrait.height}
            alt="Dustin Rose, Webentwickler in Magdeburg"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="profile-card__badge" aria-hidden="true"><img src="/logo-mark.svg" alt="" width="44" height="43" /></span>
        <div class="profile-card__body">
          <p class="profile-card__role">Webentwickler &amp; Webdesigner</p>
          <h2 class="profile-card__name">Dustin Rose</h2>
          <p class="profile-card__text">
            Seit 2020 baue ich Webseiten und Web-Apps – von Magdeburg aus, vor Ort in der Region und remote
            deutschlandweit.
          </p>
          <ul class="profile-card__links">
            <li>
              <a href={SITE.profiles.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn (öffnet in neuem Tab)">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3.5" />
                  <path d="M8 10.5v6M8 7.5v.01M11.5 16.5v-6M11.5 13a2.5 2.5 0 0 1 5 0v3.5" />
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href={SITE.profiles.github} rel="me noopener" target="_blank" aria-label="GitHub (öffnet in neuem Tab)">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
                <span>GitHub</span>
              </a>
            </li>
            <li>
              <a href="/kontakt/">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                </svg>
                <span>Anfragen</span>
              </a>
            </li>
          </ul>
        </div>
      </article>
    </div>

    <!-- Fließtext: Überschrift links, Text rechts – ohne Trennstriche und Karten -->
    <div class="about-prose">
      <section class="about-sec autoShow" aria-labelledby="anfang-title">
        <h2 class="about-sec__title" id="anfang-title">Wie alles anfing</h2>
        <div class="about-sec__body">
          <p>
            Angefangen hat alles 2020 mit dem Wolmirstedter Ohrelauf. Ich habe die WordPress-Seite des Spendenlaufs
            übernommen – und schnell gemerkt, wie viel Zeit Plugins, Updates und langsame Ladezeiten kosten.
          </p>
          <p>
            Seitdem lässt mich das Thema nicht mehr los. Die Grundlagen habe ich mir unter anderem mit dem Zertifikat
            <a class="legal-link" href={SITE.certificate.url} target="_blank" rel="noopener">Responsive Web Design</a>
            von freeCodeCamp erarbeitet, den Großteil aber in echten Projekten. Der Ohrelauf hat heute übrigens wieder
            eine eigene Webseite: komplett neu von mir gebaut, ohne WordPress, schnell und für das Smartphone gemacht.
          </p>
        </div>
      </section>

      <section class="about-sec autoShow" aria-labelledby="praegung-title">
        <h2 class="about-sec__title" id="praegung-title">Projekte, die mich geprägt haben</h2>
        <div class="about-sec__body">
          <p>
            Mein größtes Projekt ist die <a class="legal-link" href="/projekte/startplatzboerse/">Startplatzbörse</a>,
            eine Plattform für den Handel mit Startplätzen bei Lauf-, Rad- und Triathlon-Events – als Webseite und als
            App für iOS und Android. Von der Datenbank über Anmeldung und Benutzerkonten bis zu den App-Updates liegt
            alles in meiner Hand.
          </p>
          <p>
            Daneben sind Webseiten für Vereine und lokale Unternehmen entstanden, etwa für den
            <a class="legal-link" href="/projekte/ohrelauf/">Wolmirstedter Ohrelauf</a>, den
            <a class="legal-link" href="/projekte/radsportclub-magdeburg/">Radsportclub Magdeburg</a> und das
            <a class="legal-link" href="/projekte/atelier-haarkunst/">Atelier Haarkunst</a>. Dort zählt vor allem,
            dass die Seite auf dem Handy schnell lädt, einfach zu bedienen ist und bei Google gefunden wird.
          </p>
        </div>
      </section>

      <!-- Zitat als typografisches Motiv: Schriftgrößen im Wechsel, leicht schräg, schlichter Rahmen -->
      <figure class="about-quote autoShow">
        <blockquote class="about-quote__text">
          <p>
            <span class="q-line q-small">Eine Webseite ist mit dem</span>
            <span class="q-line q-big"><span class="q-initial">L</span>aunch</span>
            <span class="q-line q-mid"><em>nicht</em> fertig.</span>
            <span class="q-line q-small q-rule">Sie muss zuverlässig laufen&nbsp;–</span>
            <span class="q-line q-caps">jeden Tag.</span>
          </p>
        </blockquote>
        <figcaption class="about-quote__by"><img src="/logo-wordmark-even-dark.svg" width="140" height="20" alt="r³webdesign" /></figcaption>
      </figure>

      <section class="about-sec autoShow" aria-labelledby="betrieb-title">
        <h2 class="about-sec__title" id="betrieb-title">Auch nach dem Launch</h2>
        <div class="about-sec__body">
          <p>
            Deshalb betreibe ich meine eigenen Server in Deutschland: über ein Dutzend Dienste auf Linux, sauber
            voneinander getrennt, abgesichert und mit regelmäßigen Backups. Ich sehe, wenn etwas hakt, bevor es jemand
            bemerkt.
          </p>
          <p>
            Diese Erfahrung steckt in der <a class="legal-link" href="/leistungen/hosting-betreuung/">Betreuung</a>
            deiner Webseite: Sie liegt auf meinen Servern, alle Daten bleiben in Deutschland, und Updates, Sicherheit
            und Backups behalte ich im Blick – damit du dich um dein Geschäft oder deinen Verein kümmern kannst.
          </p>
        </div>
      </section>

      <section class="about-sec autoShow" aria-labelledby="arbeit-title">
        <h2 class="about-sec__title" id="arbeit-title">Wie ich arbeite</h2>
        <div class="about-sec__body">
          <p>
            Bei mir hast du einen festen Ansprechpartner – vom ersten Gespräch über Konzept und Umsetzung bis zur
            Betreuung danach. Ich nutze keine Baukästen, sondern baue jede Seite individuell: Sie lädt schnell, sieht gut
            aus und gehört am Ende dir. Wie ein Projekt konkret abläuft, steht unter
            <a class="legal-link" href="/leistungen/">Leistungen</a>.
          </p>
        </div>
      </section>

      <section class="about-sec autoShow" aria-labelledby="tools-title">
        <h2 class="about-sec__title" id="tools-title">Womit ich arbeite</h2>
        <dl class="about-tools">
          {skills.map((group) => (
            <div>
              <dt>{group.title}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </LegalPageShell>
</BaseLayout>

<style>
  /* Steckbrief: steht über dem Text statt mitlaufend daneben */
  .offer-aside.about-intro {
    position: static;
    margin-bottom: clamp(0.5rem, 2vw, 1rem);
  }

  /* Profilkarte: Foto links über die volle Höhe, r³-Kreis auf der Kante, Inhalt rechts */
  .profile-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    max-width: 46rem;
    min-height: 22rem;
    margin-inline: auto;
    overflow: visible;
    border-radius: 16px 32px 32px 16px;
    background: var(--c-surface);
    box-shadow: 0 30px 60px -30px rgba(27, 38, 44, 0.45), 0 0 0 1px rgba(27, 38, 44, 0.06);
  }

  .profile-card__photo {
    position: relative;
    overflow: hidden;
    border-radius: 16px 0 0 16px;
  }

  .profile-card__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  /* Kreis mit dem r³-Zeichen: sitzt mittig auf der Kante zwischen Foto und Inhalt */
  .profile-card__badge {
    position: absolute;
    top: 2rem;
    left: 40%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 5.75rem;
    height: 5.75rem;
    border: 6px solid var(--c-surface);
    border-radius: 50%;
    background: linear-gradient(140deg, #36a873 0%, var(--c-turf) 55%, var(--c-forest) 100%);
    box-shadow: 0 10px 22px -10px rgba(4, 114, 77, 0.6);
    translate: -50% 0;
  }

  .profile-card__badge img {
    width: 2.6rem;
    height: auto;
  }

  .profile-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 2.25rem 2.25rem 1.75rem 4.25rem;
  }

  .profile-card__role {
    align-self: flex-end;
    margin: 0 0 2.25rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--c-turf);
  }

  .profile-card__name {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }

  .profile-card__text {
    margin: 0.75rem 0 0;
    max-width: 28rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--c-on-sky);
  }

  /* Kontaktwege als Icon-Reihe wie im Vorbild */
  .profile-card__links {
    display: flex;
    justify-content: space-around;
    gap: 1rem;
    margin: auto 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
  }

  .profile-card__links a {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    min-width: 44px;
    min-height: 44px;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--c-turf);
    transition: color 0.2s ease, translate 0.2s ease;
  }

  .profile-card__links a span {
    color: var(--c-slate);
  }

  .profile-card__links a:hover {
    color: var(--c-forest);
    translate: 0 -2px;
  }

  .profile-card__links a:focus-visible {
    outline: 2px solid var(--c-turf);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* Handy: Foto oben, Kreis auf der Unterkante des Fotos */
  @media (max-width: 699px) {
    .profile-card {
      grid-template-columns: minmax(0, 1fr);
      border-radius: 16px 16px 28px 28px;
    }

    .profile-card__photo {
      height: 18rem;
      border-radius: 16px 16px 0 0;
    }

    .profile-card__badge {
      top: calc(18rem - 2.875rem);
      left: 1.5rem;
      width: 5rem;
      height: 5rem;
      translate: 0 0;
    }

    .profile-card__badge img {
      width: 2.2rem;
    }

    .profile-card__body {
      padding: 1rem 1.5rem 1.5rem;
    }

    .profile-card__role {
      margin-bottom: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-card__links a {
      transition: none;
    }
  }

  /* ── Fließtext unter der Profilkarte: Überschrift links, Text rechts, viel Luft, keine Linien ── */
  .about-prose {
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    max-width: 62rem;
    margin: clamp(3.5rem, 8vw, 5.5rem) auto 0;
  }

  .about-sec {
    display: grid;
    gap: 0.9rem 3rem;
  }

  @media (min-width: 860px) {
    .about-sec {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  .about-sec__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--c-ink);
    text-wrap: balance;
  }

  .about-sec__body {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }

  .about-sec__body p {
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.75;
    color: var(--c-on-sky);
  }

  /* Zitat: Schriftgrößen im Wechsel, leicht schräg gesetzt, in einem schlichten Rahmen */
  .about-quote {
    position: relative;
    justify-self: center;
    width: min(100%, 40rem);
    margin: 0;
    padding: clamp(2.25rem, 6vw, 3.5rem) clamp(1.5rem, 6vw, 4rem) clamp(1.75rem, 5vw, 2.75rem);
    border: 1.5px solid var(--c-ink);
    border-radius: 4px;
    text-align: center;
  }

  /* große Anführungszeichen sitzen auf dem Rahmen */
  .about-quote::before,
  .about-quote::after {
    position: absolute;
    height: 0.5em;
    padding: 0 0.12em;
    overflow: hidden;
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 900;
    line-height: 0.95;
    color: var(--c-turf);
    background: var(--c-bg);
  }

  .about-quote::before {
    content: '“';
    top: -0.25em;
    left: clamp(1rem, 5vw, 2.5rem);
  }

  .about-quote::after {
    content: '”';
    right: clamp(1rem, 5vw, 2.5rem);
    bottom: -0.25em;
  }

  .about-quote__text {
    margin: 0;
  }

  .about-quote__text p {
    display: grid;
    justify-items: center;
    margin: 0;
    color: var(--c-ink);
    rotate: -3deg;
  }

  .q-line {
    display: block;
    line-height: 1.05;
  }

  .q-small {
    font-size: clamp(0.9rem, 3.4vw, 1.25rem);
    font-weight: 500;
    letter-spacing: clamp(0.02em, 0.6vw, 0.06em);
    white-space: nowrap;
    color: var(--c-slate);
  }

  .q-big {
    font-size: clamp(3.2rem, 11vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    color: var(--c-turf);
  }

  .q-initial {
    font-size: 1.25em;
  }

  .q-mid {
    margin-top: 0.15rem;
    font-size: clamp(1.6rem, 5vw, 2.3rem);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .q-mid em {
    font-weight: 800;
    font-style: normal;
    color: var(--c-turf);
  }

  /* gepunktete Linien wie im Vorbild */
  .q-rule {
    margin-top: 1rem;
    padding: 0.5rem 0.75rem 0;
    border-top: 2px dotted rgba(88, 111, 124, 0.45);
  }

  .q-caps {
    margin-top: 0.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px dotted rgba(88, 111, 124, 0.45);
    font-size: clamp(2.3rem, 8vw, 3.75rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .about-quote__by {
    margin-top: 1.25rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--c-slate);
    text-align: right;
    padding-right: clamp(0.5rem, 6vw, 4rem);
    rotate: -3deg;
  }

  /* Wortmarke klein als Autor */
  .about-quote__by img {
    display: inline-block;
    width: auto;
    height: 1.2rem;
    opacity: 0.85;
  }

  /* Werkzeuge als ruhige Textzeilen */
  .about-tools {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    margin: 0;
  }

  .about-tools div {
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 560px) {
    .about-tools div {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .about-tools dt {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--c-turf);
  }

  .about-tools dd {
    margin: 0;
    line-height: 1.6;
    color: var(--c-on-sky);
  }
</style>
