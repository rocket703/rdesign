---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPageShell from '../components/LegalPageShell.astro';
import '../styles/offer.css';
---

<BaseLayout
  title="404 – Seite nicht gefunden | r³webdesign"
  description="Diese Seite gibt es leider nicht. Hier geht es zurück zur Startseite und zu den Projekten von r³webdesign."
  noindex={true}
>
  <LegalPageShell
    wide
    legalNav={false}
    cta={false}
    title="Seite nicht gefunden"
    mark="nicht gefunden"
    crumbLabel="Fehler 404"
    lead="Diese Seite gibt es leider nicht – vielleicht wurde sie verschoben oder der Link enthält einen Tippfehler."
  >
    <div class="error-actions">
      <a href="/" class="offer-cta">Zur Startseite</a>
      <a href="/projekte/" class="offer-cta error-actions__ghost">Projekte ansehen</a>
      <a href="/kontakt/" class="offer-cta error-actions__ghost">Projekt anfragen</a>
    </div>
  </LegalPageShell>
</BaseLayout>

<style>
  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
  }

  .error-actions__ghost {
    color: var(--pg-link);
    background: transparent;
    border: 2px solid var(--pg-link);
  }

  .error-actions__ghost:hover {
    background: var(--c-mint);
  }
</style>
